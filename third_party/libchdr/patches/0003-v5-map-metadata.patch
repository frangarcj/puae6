+static chd_error validate_v5_map(chd_file *chd)
+{
+    chd_header *h = &chd->header;
+    chd->compressedbytes = h->hunkbytes;
+    for (uint32_t n = 0; n < h->hunkcount; ++n) {
+        uint8_t *r = h->rawmap + n * h->mapentrybytes;
+        uint64_t at; uint32_t length;
+        if (!chd_compressed(h)) { at = (uint64_t)get_bigendian_uint32(r) * h->hunkbytes; length = at ? h->hunkbytes : 0; }
+        else {
+            at = get_bigendian_uint48(r + 4); length = get_bigendian_uint24(r + 1);
+            if (r[0] == COMPRESSION_SELF) { if (at >= h->hunkcount) return CHDERR_INVALID_DATA; continue; }
+            if (r[0] > COMPRESSION_NONE || (r[0] < 4 && !h->compression[r[0]]) || !length ||
+                (r[0] == COMPRESSION_NONE && length != h->hunkbytes)) return CHDERR_INVALID_DATA;
+            if (at > chd->file->bytes || length > chd->file->bytes - at) return CHDERR_INVALID_DATA;
+            if (length > 1024 * 1024) return CHDERR_NOT_SUPPORTED;
+            if (length > chd->compressedbytes) chd->compressedbytes = length;
+        }
+        if (at > chd->file->bytes || length > chd->file->bytes - at) return CHDERR_INVALID_DATA;
+    }
+    if (!chd_compressed(h)) return CHDERR_NONE;
+    uint8_t *color = (uint8_t *)calloc(h->hunkcount, 1);
+    if (!color) return CHDERR_OUT_OF_MEMORY;
+    chd_error result = CHDERR_NONE;
+    for (uint32_t start = 0; start < h->hunkcount; ++start) {
+        if (color[start]) continue;
+        uint32_t n = start;
+        while (!color[n] && h->rawmap[n * 12] == COMPRESSION_SELF) {
+            color[n] = 1; n = (uint32_t)get_bigendian_uint48(h->rawmap + n * 12 + 4);
+        }
+        if (color[n] == 1) { result = CHDERR_INVALID_DATA; break; }
+        uint32_t terminal = h->rawmap[n * 12] == COMPRESSION_SELF ? (uint32_t)get_bigendian_uint48(h->rawmap + n * 12 + 4) : n;
+        color[n] = 2; n = start;
+        while (color[n] == 1) {
+            uint32_t next = (uint32_t)get_bigendian_uint48(h->rawmap + n * 12 + 4);
+            put_bigendian_uint48(h->rawmap + n * 12 + 4, terminal); color[n] = 2; n = next;
+        }
+    }
+    free(color); return result;
+}
+static chd_error validate_metadata(chd_file *chd)
+{
+    uint64_t at = chd->header.metaoffset, checkpoint = at, total = 0;
+    unsigned count = 0, power = 1, span = 0;
+    while (at) {
+        uint8_t raw[16];
+        if (++count > 4096) return CHDERR_NOT_SUPPORTED;
+        if (at > chd->file->bytes || 16 > chd->file->bytes - at) return CHDERR_INVALID_METADATA;
+        if (core_read_at(chd->file, at, raw, 16) != 16) return CHDERR_READ_ERROR;
+        uint32_t length = get_bigendian_uint32(raw + 4) & 0xffffff;
+        if (length > chd->file->bytes - at - 16) return CHDERR_INVALID_METADATA;
+        total += length;
+        if (length > 65536 || total > 1024 * 1024) return CHDERR_NOT_SUPPORTED;
+        at = get_bigendian_uint64(raw + 8);
+        if (at && at == checkpoint) return CHDERR_INVALID_METADATA;
+        if (++span == power) { checkpoint = at; power *= 2; span = 0; }
+    }
+    return CHDERR_NONE;
 }
 
