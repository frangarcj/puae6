+// Native state (bridge/state_upstream.cpp, sub-body CTOD of P6CH, T50): where the CIA-A TOD that the mains drives is in its count. With cs_ciaatod 1 or 2 (50 or 60 Hz: the A1000 and the
+// A2000 of the profile) cia_hsync_do counts the colour clocks to the next tick in cia_hsync, a file static that no body names: each line lowers it by the length of the line, and the line in
+// which it falls below that length ticks the TOD and adds the length of a mains period, which it computes from vblank_hz (the rate of the frame the machine is in: compute_framesync sets
+// it to the short, long or interlaced value, and a machine that loaded a state kept the one of its own history). WinUAE's own load puts back neither (init_hz zeroes cia_hsync only when it
+// is not restoring): the next tick fell in another line and the TOD the guest read differed by one for good (the digest of the CIAs of DET02 with a real Kickstart, a state taken in the middle
+// of a game's disk loading). Two words: cia_hsync and the bits of vblank_hz. The machines whose TOD follows the vertical sync (cs_ciaatod 0) never use them and have no such body.
+bool p6_custom_ciatod_get(int32_t *out, unsigned n)
+{
+	if (!out || n != 2) return false;
+	out[0] = cia_hsync;
+	memcpy(&out[1], &vblank_hz, sizeof out[1]);
+	return true;
+}
+
+bool p6_custom_ciatod_set(const int32_t *in, unsigned n)
+{
+	if (!in || n != 2) return false;
+	cia_hsync = in[0];
+	memcpy(&vblank_hz, &in[1], sizeof vblank_hz);
+	return true;
+}
+
