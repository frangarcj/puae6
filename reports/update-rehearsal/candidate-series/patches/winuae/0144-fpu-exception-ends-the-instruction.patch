diff --git a/fpp.cpp b/fpp.cpp
--- a/fpp.cpp
+++ b/fpp.cpp
@@ -384,6 +384,11 @@ static bool fp_exception_pending(bool pre)
 			Exception(regs.fp_exp_pend);
 			if (currprefs.fpu_model != 68882)
