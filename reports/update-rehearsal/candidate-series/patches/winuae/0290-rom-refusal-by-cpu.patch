diff --git a/memory.cpp b/memory.cpp
--- a/memory.cpp
+++ b/memory.cpp
@@ -17,6 +17,14 @@
 #include "rom_status.h"
 static int rom_load_status = P6_ROM_UNLOADED;
 int p6_memory_rom_status(void) { return rom_load_status; }
+// The requirement of the known ROM that the preset's CPU cannot run (rd->cpu bits as upstream reads them) and the engine's name for it; cleared by every load and by init/cleanup.
+static int rom_refused_cpu = 0;
+static const TCHAR *rom_refused_name = NULL;
+int p6_memory_rom_refusal(const char **name)
+{
+	if (name) *name = rom_refused_cpu ? rom_refused_name : NULL;
+	return rom_refused_cpu;
+}
 #endif
 
 #include "options.h"
@@ -2140,6 +2148,8 @@ static int load_kickstart (void)
 {
 #ifdef P6_PORTABLE
 	rom_load_status = P6_ROM_READ_ERROR;
+	rom_refused_cpu = 0;
+	rom_refused_name = NULL;
 #endif
 	TCHAR tmprom[MAX_DPATH];
 
@@ -3215,6 +3225,8 @@ static void restore_roms(void)
 			    ((rd->cpu & 3) == 1 && currprefs.cpu_model < 68020) ||
 			    ((rd->cpu & 3) == 2 && (currprefs.cpu_model < 68020 || currprefs.address_space_24))) {
 				rom_load_status = P6_ROM_UNSUPPORTED;
+				rom_refused_cpu = rd->cpu;
+				rom_refused_name = rd->name;
 				return;
 			}
 #endif
@@ -3629,6 +3641,8 @@ void memory_init (void)
 {
 #ifdef P6_PORTABLE
 	rom_load_status = P6_ROM_UNLOADED;
+	rom_refused_cpu = 0;
+	rom_refused_name = NULL;
 #endif
 	init_mem_banks ();
 	virtualdevice_init ();
@@ -3674,6 +3688,8 @@ void memory_cleanup (void)
 {
 #ifdef P6_PORTABLE
 	rom_load_status = P6_ROM_UNLOADED;
+	rom_refused_cpu = 0;
+	rom_refused_name = NULL;
 #endif
 	mapped_free(&mem25bit_bank);
 	mapped_free(&a3000lmem_bank);
