diff --git a/inputdevice.cpp b/inputdevice.cpp
--- a/inputdevice.cpp
+++ b/inputdevice.cpp
@@ -6115,6 +6115,14 @@ void inputdevice_reset (void)
 	}
 	lightpen_trigger2 = 0;
 	cubo_flag = 0;
