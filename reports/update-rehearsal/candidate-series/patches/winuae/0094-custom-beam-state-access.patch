diff --git a/custom.cpp b/custom.cpp
--- a/custom.cpp
+++ b/custom.cpp
@@ -13130,4 +13130,63 @@ evfunc2 p6_custom_event2_handler(int which)
 		return fakehsync_handler;
 	}
 }
+// Native state (bridge/state_upstream.cpp, sub-body BEAM of P6CH): the position of the beam and the phase of the frame, which WinUAE's own bodies do not carry
+// (restore_custom reads VPOSR and VHPOSR and throws them away; the counters of the frame and the sync latches are not in any body). Values only, in 32-bit words in
+// the order of the list below; the line length is the one thing derived (setmaxhpos, from the saved lol, linetoggle and the standard of the configuration).
+// A word count other than P6_BEAM_WORDS is refused, so that the bridge and the engine cannot disagree on the list. Never schedules an event or runs a handler.
+//  0 vpos  1 vpos_prev  2 agnus_hpos  3 agnus_hpos_prev  4 agnus_hpos_next  5 agnus_vpos_next  6 agnus_pos_change  7 hhpos
+//  8 linear_vpos  9 linear_hpos  10-12 linear_vpos_prev  13-15 linear_hpos_prev  16 linear_vpos_vsync  17 linear_display_vpos  18 linear_vpos_visible
+//  19 current_linear_vpos_visible  20 display_hsync_counter  21 display_vsync_counter  22 maxvpos_display_vsync_next  23 linetoggle  24 lof_display
+//  25 lof_detect  26 lof_pdetect  27 lof_detect_vsync  28-30 prevlofs  31-32 display_last_hsync (low, high)  33-34 display_last_vsync (low, high)
+//  35 agnus_vb  36 agnus_pvb  37 prev_strobe (the strobe slot of the last line: VERTB is raised when it goes from STRHOR to another)
+//  38 dmal_shifter  39 dmal  40 dmal_next (the DMA list of the line in flight: it also paces the input's per-line tick)
+//  41-60 the twenty sync latches of Agnus (phsync, phblank, pvsync, pcsync, csync, vb_active, vb_start_line, pvb_start_line,
+//  vb_active_start_line, vb_end_line, pvb_end_line, vb_active_end_line, equzone, hsync, vsync, ve, p_ve, bsvb, bsvb_prev, equdis)
+#define P6_BEAM_WORDS 61
+bool p6_custom_beam_get(int32_t *out, unsigned n)
+{
+	if (!out || n != P6_BEAM_WORDS) return false;
+	const int32_t head[] = {
+		vpos, vpos_prev, agnus_hpos, agnus_hpos_prev, agnus_hpos_next, agnus_vpos_next, agnus_pos_change, hhpos,
+		linear_vpos, linear_hpos, linear_vpos_prev[0], linear_vpos_prev[1], linear_vpos_prev[2], linear_hpos_prev[0], linear_hpos_prev[1], linear_hpos_prev[2],
+		linear_vpos_vsync, linear_display_vpos, linear_vpos_visible, current_linear_vpos_visible,
+		display_hsync_counter, display_vsync_counter, maxvpos_display_vsync_next, linetoggle, lof_display,
+		lof_detect, lof_pdetect, lof_detect_vsync, prevlofs[0], prevlofs[1], prevlofs[2],
+		int32_t(uint64_t(display_last_hsync)), int32_t(uint64_t(display_last_hsync) >> 32), int32_t(uint64_t(display_last_vsync)), int32_t(uint64_t(display_last_vsync) >> 32),
+		agnus_vb, agnus_pvb, prev_strobe, int32_t(dmal_shifter), dmal, dmal_next,
+		agnus_phsync, agnus_phblank, agnus_pvsync, agnus_pcsync, agnus_csync, agnus_vb_active, agnus_vb_start_line, agnus_pvb_start_line,
+		agnus_vb_active_start_line, agnus_vb_end_line, agnus_pvb_end_line, agnus_vb_active_end_line, agnus_equzone, agnus_hsync, agnus_vsync, agnus_ve,
+		agnus_p_ve, agnus_bsvb, agnus_bsvb_prev, agnus_equdis
+	};
+	static_assert(sizeof head / sizeof head[0] == P6_BEAM_WORDS, "review the beam word list");
+	memcpy(out, head, sizeof head);
+	return true;
+}
+
+bool p6_custom_beam_set(const int32_t *in, unsigned n)
+{
+	if (!in || n != P6_BEAM_WORDS) return false;
+	vpos = in[0]; vpos_prev = in[1]; agnus_hpos = uae_u8(in[2]); agnus_hpos_prev = in[3]; agnus_hpos_next = in[4]; agnus_vpos_next = in[5];
+	agnus_pos_change = in[6]; hhpos = uae_u16(in[7]);
+	linear_vpos = in[8]; linear_hpos = in[9];
+	for (int i = 0; i < 3; ++i) {
+		linear_vpos_prev[i] = in[10 + i];
+		linear_hpos_prev[i] = in[13 + i];
+		prevlofs[i] = in[28 + i] != 0;
+	}
+	linear_vpos_vsync = in[16]; linear_display_vpos = in[17]; linear_vpos_visible = in[18]; current_linear_vpos_visible = in[19];
+	display_hsync_counter = in[20]; display_vsync_counter = in[21]; maxvpos_display_vsync_next = in[22] != 0; linetoggle = in[23] != 0; lof_display = in[24] != 0;
+	lof_detect = in[25] != 0; lof_pdetect = in[26] != 0; lof_detect_vsync = in[27] != 0;
+	display_last_hsync = evt_t(uint64_t(uint32_t(in[31])) | uint64_t(uint32_t(in[32])) << 32);
+	display_last_vsync = evt_t(uint64_t(uint32_t(in[33])) | uint64_t(uint32_t(in[34])) << 32);
+	agnus_vb = in[35]; agnus_pvb = in[36]; prev_strobe = uae_u16(in[37]); dmal_shifter = uae_u32(in[38]); dmal = uae_u16(in[39]); dmal_next = in[40] != 0;
+	bool *const latches[] = {
+		&agnus_phsync, &agnus_phblank, &agnus_pvsync, &agnus_pcsync, &agnus_csync, &agnus_vb_active, &agnus_vb_start_line, &agnus_pvb_start_line,
+		&agnus_vb_active_start_line, &agnus_vb_end_line, &agnus_pvb_end_line, &agnus_vb_active_end_line, &agnus_equzone, &agnus_hsync, &agnus_vsync, &agnus_ve,
+		&agnus_p_ve, &agnus_bsvb, &agnus_bsvb_prev, &agnus_equdis
+	};
+	for (unsigned i = 0; i < sizeof latches / sizeof latches[0]; ++i) *latches[i] = in[41 + i] != 0;
+	setmaxhpos();
+	return true;
+}
 #endif
