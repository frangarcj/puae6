diff --git a/keybuf.cpp b/keybuf.cpp
--- a/keybuf.cpp
+++ b/keybuf.cpp
@@ -336,6 +336,18 @@ int record_key_direct(int kc, bool direct)
 	return 1;
 }
 
+#ifdef P6_PORTABLE
+// Free places in the ring (one stays empty). A full ring drops the NEW code, so an edge that does not fit would
+// leave the guest with a key stuck down or up; the bridge sends an edge only when it is certain to fit.
+int keybuf_free (void)
+{
+	int used = kpb_first - kpb_last;
+	if (used < 0)
+		used += KEYBUF_SIZE;
+	return KEYBUF_SIZE - 1 - used;
+}
+#endif
+
 void keybuf_init (void)
 {
 	kpb_first = kpb_last = 0;
diff --git a/include/keybuf.h b/include/keybuf.h
--- a/include/keybuf.h
+++ b/include/keybuf.h
@@ -20,4 +20,7 @@ extern void setcapslockstate(int);
 extern void keybuf_inject(const uae_char*);
 extern void keybuf_ignore_next_release(void);
 extern void keybuf_vsync(void);
+#ifdef P6_PORTABLE
+extern int keybuf_free(void);
+#endif
 #endif /* UAE_KEYBUF_H */
