diff --git a/newcpu.cpp b/newcpu.cpp
--- a/newcpu.cpp
+++ b/newcpu.cpp
@@ -10727,3 +10727,26 @@ void dfc_nommu_put_long(uaecptr addr, uae_u32 v)
 		x_put_long(addr, v);
 	ismoves_nommu = false;
 }
+
+#ifdef P6_PORTABLE
+// Native state (bridge/state_cpu.cpp): true at an instruction boundary of a machine whose CPU loop is started and that is in a mode the A500
+// profile can be in; otherwise `why` names the first thing that is not. Everything tested here is written before it is read, or never
+// written in the profile, so it is a check and not a part of the state.
+bool p6_cpu_boundary(const char **why)
+{
+	const char *w = NULL;
+	if (!in_m68k_go)
+		w = "the CPU loop is not started";
+	else if (regs.exception || exception_in_exception)
+		w = "an exception is in flight";
+	else if (regs.loop_mode || regs.t0 || regs.m || regs.vbr || regs.sfc || regs.dfc || regs.msp || regs.lastipl)
+		w = "a register or mode that only a 68010 or later has is set";
+	else if (regs.spcflags & ~(SPCFLAG_CPUINRESET | SPCFLAG_TRACE | SPCFLAG_DOTRACE | SPCFLAG_BLTNASTY | SPCFLAG_CHECK))
+		w = "a special flag is pending that the profile never leaves pending at a unit boundary";
+	else if (cpu_tracer || cpu_prefs_changed_flag || m68k_reset_delay || pissoff)
+		w = "a file-local CPU counter is not at its boundary value";
+	if (why)
+		*why = w;
+	return w == NULL;
+}
+#endif
