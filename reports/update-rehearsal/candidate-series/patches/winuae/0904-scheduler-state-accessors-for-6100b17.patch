diff --git a/events.cpp b/events.cpp
--- a/events.cpp
+++ b/events.cpp
@@ -594,7 +594,7 @@ void clear_events(void)
 // place; it also leaves the re-entry counters of MISC_handler at zero, where they are at every instruction boundary.
 void p6_events_get(int *idx, int *next, int *cnt, int *restart, int *remain)
 {
-	*idx = firstvent2idx;
+	*idx = firstvent2idx + 1;   // firstvent2idx is -1 when no secondary event is pending: the state carries it as 0..ev2_max
 	*next = event2next;
 	*cnt = event2cnt;
 	*restart = event2restart;
@@ -603,10 +603,23 @@ void p6_events_get(int *idx, int *next, int *cnt, int *restart, int *remain)
 
 void p6_events_set(int idx, int next, int remain)
 {
-	firstvent2idx = idx;
+	firstvent2idx = idx - 1;
 	event2next = next;
 	event2cnt = 0;
 	event2restart = 0;
+	// The table was written slot by slot by the bridge: the number of slots the loops visit (it doubles as slots are used) and the count of
+	// pending ones are derived from it, as events_schedule_misc() derives the count.
+	int last = -1, total = 0;
+	for (int i = 0; i < ev2_max; i++) {
+		if (eventtab2[i].active) {
+			last = i;
+			total++;
+		}
+	}
+	while (event2max < ev2_max && event2max <= last) {
+		event2max *= 2;
+	}
+	event2total = total;
 	cycles_to_add_remain = remain;
 }
 #endif
