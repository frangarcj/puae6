+++ b/blitter.cpp
@@ -2803,4 +2803,10 @@ bool p6_blitter_phase_set(const int32_t *in, unsigned n)
 	return true;
 }
 
+// Native state (bridge/state_cpu.cpp): the blitter's secondary-event handler is file-local in 6100b17 (it no longer owns slot 0); a state names it by an id of its own.
