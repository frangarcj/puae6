+		int32_t(rga_pipe[0].conflictaddr), int32_t(rga_pipe[1].conflictaddr), int32_t(rga_pipe[2].conflictaddr), int32_t(rga_pipe[3].conflictaddr)
 	};
 	static_assert(sizeof head / sizeof head[0] == P6_BEAM_WORDS, "review the beam word list");
 	memcpy(out, head, sizeof head);
@@ -13247,6 +13262,11 @@ bool p6_custom_beam_set(const int32_t *in, unsigned n)
 	for (unsigned i = 0; i < sizeof latches / sizeof latches[0]; ++i) *latches[i] = in[41 + i] != 0;
 	plffirstline = in[61]; plflastline = in[62]; need_vdiw_check = in[63] != 0; interlace_seen = in[64];
 	programmed_register_accessed_h = in[65] != 0; programmed_register_accessed_v = in[66] != 0;
