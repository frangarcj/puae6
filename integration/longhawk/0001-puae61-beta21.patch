@@ -0,0 +1,18 @@
+# PUAE61 beta21 guest
+
+`PUAE61` is the side-by-side WinUAE 6.1.0 beta 21 option. It does not replace
+BizHawk's `UAE` core or LongHawk's existing `PUAE6` core.
+
+The Windows x64 guest is `puae61-x64.wbx`; its SHA-256 is
+`6893d33541cf28cf27a244aec2950f6f4f3bde5f3d3036a5acdbdeb1a83c8f46`.
+The frontend installs it as `Assets/dll/puae61.wbx` and compiles that hash into
+`BizHawk.Emulation.Cores.dll` as `Puae61GuestSha256`. A missing, renamed or
+different guest is rejected before firmware or media are acquired.
+
+`source.tar.gz` contains the corresponding PUAE6 sources, the pristine official
+WinUAE beta21 snapshot and the complete ordered patch queue. Keep it with any
+distributed binary. No Kickstart ROM or game is included.
+
+States and movies remain build-specific. `PUAE6` and `PUAE61` deliberately use
+different core names, guest files and guest hashes; neither may load the other's
+state or silently substitute its guest.
diff --git a/waterbox/puae61/prepare.py b/waterbox/puae61/prepare.py
new file mode 100644
index 0000000..5205bf9
--- /dev/null
+++ b/waterbox/puae61/prepare.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Install the pinned PUAE61 beta21 Windows guest and corresponding sources."""
+
+import argparse
+import hashlib
+from pathlib import Path
+import shutil
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+GUEST = HERE / 'puae61-x64.wbx'
+SOURCES = HERE / 'source.tar.gz'
+GUEST_SHA = '6893d33541cf28cf27a244aec2950f6f4f3bde5f3d3036a5acdbdeb1a83c8f46'
+SOURCES_SHA = '791a9fdf28bd0f710b5d52d834d407a9e401ceb4598cfeed9bbec3ded4d2b171'
+
+
+def digest(path):
+	return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def prepare():
+	for path, expected in ((GUEST, GUEST_SHA), (SOURCES, SOURCES_SHA)):
+		if path.is_symlink() or not path.is_file() or digest(path) != expected:
+			raise ValueError(f'{path.name} identity differs')
+	assets = ROOT / 'Assets'
+	dll = assets / 'dll'
+	notices = assets / 'PUAE61'
+	dll.mkdir(parents=True, exist_ok=True)
+	notices.mkdir(parents=True, exist_ok=True)
+	if (dll / 'puae61.wbx.zst').exists():
+		raise ValueError('Remove the conflicting puae61.wbx.zst explicitly before preparing')
+	shutil.copyfile(GUEST, dll / 'puae61.wbx')
+	shutil.copyfile(SOURCES, notices / 'source.tar.gz')
+	shutil.copyfile(HERE / 'README.md', notices / 'README.md')
+	print('Prepared pinned PUAE61 beta21 x64 guest and corresponding sources')
+
+
+def main():
+	parser = argparse.ArgumentParser(description=__doc__)
+	parser.add_argument('command', choices=('pin', 'prepare'))
+	args = parser.parse_args()
+	if args.command == 'pin':
+		print(GUEST_SHA)
+	else:
+		prepare()
+
+
+if __name__ == '__main__':
+	main()
