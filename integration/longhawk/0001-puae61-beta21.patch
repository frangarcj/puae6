+#!/usr/bin/env python3
+"""Install the pinned PUAE61 beta21 Windows guest and corresponding sources."""
+
+import argparse
+import hashlib
+from pathlib import Path
+import shutil
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+GUEST = HERE / 'puae61-x64.wbx'
+SOURCES = HERE / 'source.tar.gz'
+GUEST_SHA = 'a244f88642163ab6163d92d3ba3ed004a5e02c5eb2f94b99f41f89484c80a2b2'
+SOURCES_SHA = 'dfaf5c5ec4fc81cc95ccc59f4ce5e88fb2c74e11d1784bdb1fa817e15aff0c0b'
+
+
+def digest(path):
+	return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def prepare():
+	for path, expected in ((GUEST, GUEST_SHA), (SOURCES, SOURCES_SHA)):
+		if path.is_symlink() or not path.is_file() or digest(path) != expected:
+			raise ValueError(f'{path.name} identity differs')
+	assets = ROOT / 'Assets'
+	dll = assets / 'dll'
+	notices = assets / 'PUAE61'
+	dll.mkdir(parents=True, exist_ok=True)
+	notices.mkdir(parents=True, exist_ok=True)
+	if (dll / 'puae61.wbx.zst').exists():
+		raise ValueError('Remove the conflicting puae61.wbx.zst explicitly before preparing')
+	shutil.copyfile(GUEST, dll / 'puae61.wbx')
+	shutil.copyfile(SOURCES, notices / 'source.tar.gz')
+	shutil.copyfile(HERE / 'README.md', notices / 'README.md')
+	print('Prepared pinned PUAE61 beta21 x64 guest and corresponding sources')
+
+
+def main():
+	parser = argparse.ArgumentParser(description=__doc__)
+	parser.add_argument('command', choices=('pin', 'prepare'))
+	args = parser.parse_args()
+	if args.command == 'pin':
+		print(GUEST_SHA)
+	else:
+		prepare()
+
+
+if __name__ == '__main__':
+	main()

