     ldp     x21, x22, [sp, #64]
     ldp     x19, x20, [sp, #80]
-    msr     tpidr_el0, x9          // restore complete host nonvolatile state
 
     stp     x10, xzr, [sp, #-16]!
     blr     x11
     ldp     x10, xzr, [sp], #16
     mov     x28, x10
-    msr     tpidr_el0, x10         // legacy Waterbox AArch64 guest TLS
 
