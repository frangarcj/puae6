@@ -1,5 +1,9 @@
 .section .text
 
+// Darwin owns TPIDR_EL0, including CPU0/cluster0 == zero. Guest Context/TLS
+// uses x28 only: no mirror and no stale CPU/cluster restoration on return.
+// Keep the reserved second word of the host frame to preserve stack offsets.
+
 // Constant definitions (replaces %define)
 .equ BASE_ADDR, 0x35f00000000
 .macro RVA addr
@@ -45,9 +49,8 @@ guest_syscall:
 
