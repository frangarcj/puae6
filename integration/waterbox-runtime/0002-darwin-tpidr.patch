 }
+
+
+#[cfg(all(test, target_os = "macos", target_arch = "aarch64"))]
+mod darwin_tpidr_tests {
+	use super::*;
+	use core::arch::asm;
+
+	extern "C" fn prepare_once() {
+		prepare_thread();
+	}
+
+	#[test]
+	fn darwin_prepare_thread_preserves_cpu_zero() {
+		// Resolve lazy data and allocate the TIB while the host register is valid.
+		assert_eq!(INTEROP_AREA.start, ORG);
+		let tib = TIB.with(|b| b.as_ref() as *const usize as usize);
+		let mut samples = [0usize; 8];
+		for observed in &mut samples {
+			unsafe {
+				// No assertion/allocation between forcing CPU0 and restoring the
+				// original value. x22 survives the real prepare_thread call.
+				asm!(
+					"mrs x22, tpidr_el0",
+					"msr tpidr_el0, xzr",
+					"blr x21",
+					"mrs x20, tpidr_el0",
+					"msr tpidr_el0, x22",
+					in("x21") prepare_once as *const () as usize,
+					out("x22") _, out("x20") *observed,
+					clobber_abi("C"),
+				);
+			}
+		}
+		assert!(!samples.contains(&tib), "prepare_thread published TIBptr: {:x?}", samples);
+		// XNU can replace zero on preemption. Require one uninterrupted sample
+		// rather than mistaking eight preemptions for proof of preservation.
+		assert!(samples.contains(&0), "CPU0 observation preempted: {:x?}", samples);
+	}
+
+	// This leaf runs on the guest stack through the actual interop entry. It
+	// deliberately observes TPIDR instead of using the supported guest TLS x28.
+	extern "C" fn read_tpidr_leaf() -> usize {
+		let value;
+		unsafe { asm!("mrs {0}, tpidr_el0", out(reg) value, options(nomem, nostack, preserves_flags)); }
+		value
+	}
+
+	extern "C" fn enter_leaf(entry: usize, context: &mut Context) -> usize {
+		call_guest_simple(entry, context)
+	}
+
+	extern "C" fn unexpected_syscall(
+		_: usize, _: usize, _: usize, _: usize, _: usize, _: usize,
+		_: SyscallNumber, _: &mut WaterboxHost,
+	) -> SyscallReturn {
+		// A native leaf has no syscalls; entering this dispatcher is a failure.
+		std::process::abort()
+	}
+
+	#[test]
+	fn darwin_interop_does_not_mirror_context_in_tpidr() {
+		assert_eq!(INTEROP_AREA.start, ORG);
+		#[repr(align(16))]
+		struct GuestStack([u8; 4096]);
+		let mut stack = GuestStack([0; 4096]);
+		let top = stack.0.as_mut_ptr() as usize + stack.0.len();
+		let mut context = Context::new(top, 0, unexpected_syscall);
+		let context_ptr = &mut context as *mut Context as usize;
+		let guest_tpidr: usize;
+		let returned_tpidr: usize;
+		unsafe {
+			// The old interop writes Context* even if XNU supplied a valid zero.
+			// Restore host TPIDR immediately after returning, before Rust assertions.
+			asm!(
+				"mrs x22, tpidr_el0",
+				"msr tpidr_el0, xzr",
+				"blr x21",
+				"mrs x20, tpidr_el0",
+				"msr tpidr_el0, x22",
+				in("x21") enter_leaf as *const () as usize,
+				inout("x0") read_tpidr_leaf as *const () as usize => guest_tpidr,
+				in("x1") context_ptr,
+				out("x22") _, out("x20") returned_tpidr,
+				clobber_abi("C"),
+			);
+		}
+		assert_ne!(guest_tpidr, context_ptr, "interop exposed Context* as Darwin TPIDR");
+		assert_ne!(returned_tpidr, context_ptr, "interop leaked Context* after return");
+		assert_eq!(context.host_rsp, 0);
+		assert_eq!(context.guest_rsp, top);
+	}
+}
