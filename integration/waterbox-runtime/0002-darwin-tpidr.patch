     mov     x10, x28               // x28 is reserved throughout the guest
@@ -157,8 +157,7 @@ do_switch:
     str     x9,  [x10, #32]
 
 done:
-    ldp     x29, x9, [sp], #16
-    msr tpidr_el0, x9
+    ldp     x29, xzr, [sp], #16
 
     ldp x27, x28, [sp], #16
     ldp x25, x26, [sp], #16
@@ -213,19 +212,17 @@ guest_extcall_impl:
     add     x11, x10, #56          // &extcall_slots[0]
     ldr     x11, [x11, x8, lsl #3]
 
