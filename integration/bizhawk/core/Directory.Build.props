<Project>
	<!-- Outputs go to build/, never next to the sources; set here because MSBuild reads it before the SDK props. -->
	<PropertyGroup>
		<BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../build/bizhawk-core/obj/</BaseIntermediateOutputPath>
		<BaseOutputPath>$(MSBuildThisFileDirectory)../../../build/bizhawk-core/bin/</BaseOutputPath>
	</PropertyGroup>
</Project>
