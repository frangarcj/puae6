+++ b/src/BizHawk.Emulation.DiscSystem/Internal/SectorSynth.cs
@@ -205,6 +205,13 @@
 	}
 
 
+	// A mount-local overlay; it borrows the same Disc and its existing provider/resources.
+	internal sealed class SbiSectorSynthProvider(Disc owner, ISectorSynthProvider parent, Dictionary<int, SS_PatchQ> patches) : ISectorSynthProvider
+	{
+		public ISectorSynthJob2448 Get(int lba)
+			=> owner.IsDisposed ? null : patches.TryGetValue(lba, out var patch) ? patch : parent.Get(lba);
+	}
+
 	internal class SS_PatchQ : ISectorSynthJob2448
 	{
 		public ISectorSynthJob2448 Original;
@@ -217,9 +224,13 @@
 			if ((job.Parts & ESectorSynthPart.SubchannelQ) == 0)
 				return;
 
-			//apply patched subQ
-			for (var i = 0; i < 12; i++)
-				job.DestBuffer2448[2352 + 12 + i] = Buffer_SubQ[i];
+			var start = job.DestOffset + 2352;
+			if ((job.Parts & ESectorSynthPart.SubcodeDeinterleave) != 0)
+				Buffer.BlockCopy(Buffer_SubQ, 0, job.DestBuffer2448, start + 12, 12);
+			else
+				for (var i = 0; i < 96; i++)
+					job.DestBuffer2448[start + i] = (byte)((job.DestBuffer2448[start + i] & 0xBF)
+						| (((Buffer_SubQ[i / 8] >> (7 - i % 8)) & 1) << 6));
 		}
 	}
 
