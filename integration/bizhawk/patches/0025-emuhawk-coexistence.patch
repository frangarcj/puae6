+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Text;
+using BizHawk.Client.Common;
+using BizHawk.Common;
+using BizHawk.Emulation.Common;
+using BizHawk.Emulation.Cores.Arcades.MAME;
+using BizHawk.Emulation.Cores.Computers.Amiga;
+using Newtonsoft.Json;
+using Puae6;
+
+namespace BizHawk.Client.EmuHawk
+{
+ internal static class Puae6Coexistence
+ {
+  private static readonly string Stage = AppContext.BaseDirectory;
+  [DllImport("libSystem.B.dylib", EntryPoint = "_dyld_image_count")] private static extern uint ImageCount();
+  [DllImport("libSystem.B.dylib", EntryPoint = "_dyld_get_image_name")] private static extern IntPtr ImageName(uint index);
+  private static void Require(bool value, string message) { if (!value) throw new InvalidOperationException(message); }
+  private static string Hash(byte[] bytes) { using var sha = SHA256.Create(); return BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-", "").ToLowerInvariant(); }
+  private static byte[] State(IEmulator core) { using var stream = new MemoryStream(); using var writer = new BinaryWriter(stream); core.AsStatable().SaveStateBinary(writer); return stream.ToArray(); }
+  private static void Identity(Dictionary<string, string> native)
+  {
+   var loaded = Enumerable.Range(0, checked((int)ImageCount())).Select(i => Marshal.PtrToStringAnsi(ImageName((uint)i)))
+    .Where(p => Path.GetFileName(p) == "libwaterboxhost.dylib").ToArray();
+   Require(loaded.Length == 1 && loaded[0] == Path.Combine(Stage, "dll", "libwaterboxhost.dylib"), "Runtime is not the single staged image");
+   foreach (var item in native) Require(Hash(File.ReadAllBytes(Path.Combine(Stage, "dll", item.Key))) == item.Value, "Native input changed");
+  }
+  private sealed class Buttons : IController
+  {
+   public int Frame;
+   public ControllerDefinition Definition { get; }
+   public string Fire { get; }
+   public Buttons(ControllerDefinition definition) { Definition = definition; Fire = definition.BoolButtons.Single(n => n.StartsWith("P2 ", StringComparison.Ordinal) && n.EndsWith("Button 1", StringComparison.Ordinal)); }
+   public bool IsPressed(string name) => name == Fire && Frame % 3 == 1;
+   public int AxisValue(string name) => Definition.Axes[name].Neutral;
+   public IReadOnlyCollection<(string Name, int Strength)> GetHapticsSnapshot() => Array.Empty<(string, int)>();
+   public void SetHapticChannelStrength(string name, int strength) { }
+  }
+  private static MovieSession Session() => new MovieSession(new MovieConfig { EnableBackupMovies = false,
+   DefaultTasStateManagerSettings = new PagedStateManager.PagedSettings { TotalMemoryLimitMB = 64, FramesBetweenNewStates = 1, FramesBetweenSavedStates = 1, ForceSaveMarkerStates = true }
+  }, Path.Combine(Stage, "Movies"), null, () => { }, () => { }, (_, _) => { });
+  private static Config Configuration(string preferred)
+  {
+   var config = new Config { DontTryOtherCores = true };
+   var entries = new List<PathEntry>();
+   foreach (var type in new[] { "Base", "Firmware", "Movies", "Movie backups", "Temp Files" })
+    entries.Add(new PathEntry(PathEntryCollection.GLOBAL, type, type == "Base" ? Stage : Path.Combine(Stage, type)));
+   entries.Add(new PathEntry("Amiga", "Base", Stage)); entries.Add(new PathEntry("Amiga", "User", Path.Combine(Stage, "User")));
+   config.PathEntries = new PathEntryCollection(entries);
+   Require(config.PreferredCores["Amiga"] == "UAE", "Default Amiga core changed");
+   if (preferred != "UAE") config.PreferredCores["Amiga"] = preferred;
+   config.FirmwareUserSpecifications[new FirmwareID("Amiga", "A500").ConfigKey] = Path.Combine(Stage, "Firmware", "Own.rom");
+   return config;
+  }
+  private static IEmulator Open(string name, MovieSession session, string path, bool record)
+  {
+   var config = Configuration(record ? name : name == "UAE" ? "PUAE6" : "UAE");
+   if (record && name == "UAE") config.PreferredCores.Remove("Amiga");
+   if (!record) {
+    Require(config.PreferredCores["Amiga"] != name, "Replay preference is not contrary");
+    session.QueueNewMovie(session.Get(path, true), "Amiga", Database.GetGameInfo(File.ReadAllBytes(Path.Combine(Stage, "Own.adf")), "Own.adf").Hash, config.PathEntries, config.PreferredCores);
+    Require(session.QueuedCoreName == name, "Movie did not preserve core identity");
+    config.PreferredCores["Amiga"] = name == "UAE" ? "PUAE6" : "UAE";
+    Require(config.PreferredCores["Amiga"] != session.QueuedCoreName, "Queued playback preference is not contrary");
+   }
+   var provider = new CoreFileProvider(null, new FirmwareManager(), config.PathEntries, config.FirmwareUserSpecifications);
+   var comm = new CoreComm(message => throw new InvalidOperationException(message), (_, _) => { }, provider, CoreComm.CorePreferencesFlags.None, null);
+   var loader = new RomLoader(config, null) { Deterministic = true };
+   loader.OnLoadError += (_, e) => throw new InvalidOperationException(e.Message);
+   loader.OnLoadSettings += (_, e) => e.Settings = e.Core == typeof(UAE) ? (object)new UAE.UAESettings() : new Puae6Settings();
+   loader.OnLoadSyncSettings += (_, e) => e.Settings = session.NewMovieQueued ? ConfigService.LoadWithType(session.QueuedSyncSettings)
+    : e.Core == typeof(UAE) ? (object)new UAE.UAESyncSettings { MachineConfig = UAE.MachineConfig.A500_OCS_130_512K_512K, CdController = UAE.CdController.None,
+       FloppyDrives = 1, ControllerPort1 = LibUAE.ControllerType.Mouse, ControllerPort2 = LibUAE.ControllerType.DJoy }
+    : new Puae6SyncSettings { Machine = Puae6Machine.A500, WhdLoad = Puae6WhdLoadMode.Disabled };
+   Require(loader.LoadRom(Path.Combine(Stage, "Own.adf"), comm, null, record ? null : session.QueuedCoreName), "RomLoader failed");
+   var core = loader.LoadedEmulator;
+   Require(core.GetType() == (name == "UAE" ? typeof(UAE) : typeof(Puae6Core)) && core.Attributes().CoreName == name, "Wrong RomLoader core");
+   core.ControllerDefinition.BuildMnemonicsCache("Amiga"); session.MovieIn = new Buttons(core.ControllerDefinition); session.StickySource = session.MovieIn;
+   if (record) {
+    var movie = session.Get(path, false); movie.Core = name; movie.SystemID = "Amiga"; movie.Hash = loader.Game.Hash; movie.GameName = "Own disk";
+    movie.SyncSettingsJson = ConfigService.SaveWithType(core is UAE uae ? (object)uae.GetSyncSettings() : ((Puae6Core)core).GetSyncSettings());
+    if (core is Puae6Core p6) foreach (var header in Puae6Movie.HeaderForStart(p6, false, null)) movie.HeaderEntries[header.Key] = header.Value;
+    session.QueueNewMovie(movie, "Amiga", loader.Game.Hash, config.PathEntries, config.PreferredCores);
+   }
+   session.RunQueuedMovie(record, core); return core;
+  }
+  private static string[] Step(IEmulator core, MovieSession session)
+  {
+   var input = (Buttons)session.MovieIn; input.Frame = core.Frame; session.HandleFrameBefore();
+   Require(session.MovieOut.IsPressed(input.Fire) == input.IsPressed(input.Fire), "Movie input differs");
+   int before = core.Frame; Require(core.FrameAdvance(session.MovieOut, true, true) && core.Frame == before + 1, "Frame did not advance");
+   var video = core.AsVideoProvider(); var pixels = new byte[video.BufferWidth * video.BufferHeight * 4]; Buffer.BlockCopy(video.GetVideoBuffer(), 0, pixels, 0, pixels.Length);
+   core.AsSoundProvider().GetSamplesSync(out var samples, out int count); Require(count > 0 && pixels.Length > 0, "Empty A/V");
+   var pcm = new byte[count * 4]; Buffer.BlockCopy(samples, 0, pcm, 0, pcm.Length); session.HandleFrameAfter(true);
+   return new[] { Hash(pixels), Hash(pcm) };
+  }
+  private static void Close(MovieSession session) { session.Movie.Stop(); if (session.Movie is IDisposable disposable) disposable.Dispose(); }
+  [MethodImpl(MethodImplOptions.NoInlining)]
+  public static int Run(string[] args)
+  {
+   try {
+    if (args.Length != 1) throw new ArgumentException("--puae6-coexistence accepts no other arguments", nameof(args));
+    Require(Puae6SelfCheck.Run(new[] { "--puae6-self-check" }) == 0, "Full inventory bootstrap failed");
+    HawkFile.DearchivalMethod = SharpCompressDearchivalMethod.Instance;
+    var db = Path.Combine(Stage, "gamedb"); Database.InitializeDatabase(db, db, true); MAMEMachineDB.Initialize(db);
+    foreach (var directory in new[] { "User", "Movies", "Movie backups", "Temp Files" }) Directory.CreateDirectory(Path.Combine(Stage, directory));
+    var native = JsonConvert.DeserializeObject<Dictionary<string, string>>(File.ReadAllText(Path.Combine(Stage, "native.json")));
+    var cases = new List<Dictionary<string, object>>(); var names = new[] { "UAE", "PUAE6" };
+    foreach (string format in new[] { "bk2", "tasproj" }) {
+     var rows = new[] { new List<string[]>(), new List<string[]>() }; var states = new byte[2][];
+     for (int pass = 0; pass < 2; pass++) {
+      var sessions = new[] { Session(), Session() }; var cores = new IEmulator[2];
+      try {
+       for (int i = 0; i < 2; i++) cores[i] = Open(names[i], sessions[i], Path.Combine(Stage, "Movies", names[i] + "." + format), pass == 0);
+       Identity(native);
+       for (int frame = 0; frame < 12; frame++) for (int i = 0; i < 2; i++) {
+        var other = State(cores[1 - i]); var row = Step(cores[i], sessions[i]);
+        Require(other.SequenceEqual(State(cores[1 - i])), "Advancing one sandbox changed the other");
+        if (pass == 0) rows[i].Add(row); else Require(row.SequenceEqual(rows[i][frame]), "Replay A/V differs");
+       }
+       for (int i = 0; i < 2; i++) {
+        Require(sessions[i].Movie.InputLogLength == 12, "Movie did not preserve all twelve frames");
+        var state = State(cores[i]);
+        if (pass == 0) { states[i] = state; Require(!sessions[i].Movie.Save().IsError, "Movie save failed"); }
+        else { Require(state.SequenceEqual(states[i]), "Replay final state differs"); cases.Add(new Dictionary<string, object> {
+          ["format"] = format, ["core"] = names[i], ["frames"] = 12, ["replayed"] = 12, ["isolation"] = true,
+          ["video_sha256"] = Hash(Encoding.UTF8.GetBytes(string.Join("\n", rows[i].Select(r => r[0])))),
+          ["audio_sha256"] = Hash(Encoding.UTF8.GetBytes(string.Join("\n", rows[i].Select(r => r[1])))), ["state_sha256"] = Hash(state) }); }
+       }
+      } finally { for (int i = 0; i < 2; i++) { if (sessions[i].Movie != null) Close(sessions[i]); cores[i]?.Dispose(); } }
+      Identity(native);
+     }
+    }
+    Console.WriteLine("P6_EMUHAWK_COEXISTENCE " + JsonConvert.SerializeObject(new Dictionary<string, object> {
+      ["runtime"] = Environment.Version.ToString(), ["same_process"] = true, ["native"] = native, ["cases"] = cases })); return 0;
+   } catch (Exception error) { Console.Error.WriteLine(error); return 2; }
+  }
+ }
+}
