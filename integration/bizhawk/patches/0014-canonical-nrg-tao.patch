+		internal static Disc LoadPuae6Nrg(string path, DiscMountPolicy policy)
+		{
+			NRGFile parsed;
+			using (var file = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read)) parsed = ParseFrom(file, true);
+			if (parsed.DAOTrackInfos.Count != 0) return LoadNRGToDisc(path, policy);
+			var tracks = parsed.TAOTrackInfos[0].Tracks;
+			if (tracks.Count is < 1 or > 99) throw new NRGParseException("Invalid TAO track count");
+			long physical = 0, packed = 0;
+			foreach (var track in tracks)
+			{
+				var stride = track.Mode switch { 0 or 2 => 2048, 3 => 2336, 7 => 2352, _ => 0 };
+				if (stride == 0 || track.TrackFileOffset != physical || track.TrackLength == 0 ||
+					track.TrackLength > (ulong)(parsed.FileOffset - physical) || track.TrackLength % (uint)stride != 0 || track.StartLBA != packed)
+					throw new NRGParseException("Invalid canonical TAO extents/mode/packed sector");
+				physical += (long)track.TrackLength; packed += (long)(track.TrackLength / (uint)stride);
+				if (packed + (tracks.Count - 1) * 150 > 100 * 60 * 75 - 150) throw new NRGParseException("TAO exceeds MSF range");
+			}
+			if (physical != parsed.FileOffset) throw new NRGParseException("Noncontiguous TAO payload");
+			var disc = new Disc();
+			try
+			{
+				var blob = new Blob_RawFile { PhysicalPath = path }; disc.DisposableResources.Add(blob);
+				var session = new DiscSession { Number = 1 };
+				var regions = new List<DiscRegionInfo>();
+				for (var n = 0; n < tracks.Count; n++)
+				{
+					var track = tracks[n]; var control = track.Mode == 7 ? EControlQ.None : EControlQ.DATA;
+					var type = (LibChd.chd_track_type)(track.Mode switch { 0 => 0, 2 => 3, 3 => 2, _ => 7 });
+					var stride = track.Mode switch { 0 or 2 => 2048, 3 => 2336, _ => 2352 };
+					var one = disc._Sectors.Count; // Before its canonical150: visible INDEX01 equals this absolute frame.
+					void Add(SS_Base synth, int relative, bool pause)
+					{
+						synth.Policy = policy; synth.sq.SetStatus(1, control); synth.sq.q_tno = BCD2.FromDecimal(n + 1);
+						synth.sq.q_index = BCD2.FromDecimal(pause ? 0 : 1); synth.sq.Timestamp = relative;
+						synth.sq.AP_Timestamp = disc._Sectors.Count; synth.Pause = pause; disc._Sectors.Add(synth);
+					}
+					// libMirage a9d6a204 ETN: NULL150 + data fragment at byte offset, never stored pregap.
+					for (var i = 0; i < 150; i++) Add(new SS_Gap { TrackType = track.Mode == 7 ? CueTrackType.Audio : track.Mode == 0 ? CueTrackType.Mode1_2352 : CueTrackType.Mode2_2336 }, i - 150, true);
+					if (n != 0) regions.Add(new(one - 150, one, n + 1, 0, type, LibChd.chd_sub_type.CD_SUB_NONE, true));
+					var q = default(SubchannelQ); q.SetStatus(1, control); q.q_index = BCD2.FromDecimal(n + 1); q.AP_Timestamp = one + 150;
+					session.RawTOCEntries.Add(new() { QData = q, AbsoluteTimestamp = one + 150 });
+					for (var k = 0; k < (long)(track.TrackLength / (uint)stride); k++)
+					{
+						SS_Base synth = track.Mode switch { 0 => new SS_Mode1_2048(), 2 => new SS_Mode2_Form1_2048(), 3 => new SS_Mode2_2336(), _ => new SS_2352() };
+						synth.Blob = blob; synth.BlobOffset = track.TrackFileOffset + (long)k * stride; Add(synth, k, false);
+					}
+					regions.Add(new(one, disc._Sectors.Count - 150, n + 1, 1, type, LibChd.chd_sub_type.CD_SUB_NONE, false));
+				}
+				new Synthesize_A0A1A2_Job(1, tracks.Count, tracks.Any(t => t.Mode is 2 or 3) ? SessionFormat.Type20_CDXA : SessionFormat.Type00_CDROM_CDDA, disc._Sectors.Count).Run(session.RawTOCEntries);
+				disc.Sessions.Add(session); disc.Regions = regions.AsReadOnly(); return disc;
+			}
+			catch { disc.Dispose(); throw; }
+		}
