+		private sealed class OwnedDiscAsset : DiscAsset, IOwnedDiscAsset
+		{
+			private bool _disposed;
+			public void Dispose() { if (!_disposed) { _disposed = true; DiscData.Dispose(); } }
+		}
+		private bool UsePuae6Chd(string path, string system, string forcedCoreName)
+		{
+			if (!".chd".EqualsIgnoreCase(Path.GetExtension(path)) || system != null && system != VSystemID.Raw.Amiga) return false;
+			if (forcedCoreName != null) return forcedCoreName == CoreNames.PUAE6;
+			return system == VSystemID.Raw.Amiga && _config.PreferredCores.TryGetValue(system, out var preferred) && preferred == CoreNames.PUAE6;
+		}
+		private IDiscAsset MountDiscAsset(string path, string system, string forcedCoreName)
+		{
+			bool own = UsePuae6Chd(path, system, forcedCoreName);
+			var disc = own ? DiscMountJob.MountPuae6Chd(path)
+				: DiscExtensions.CreateAnyType(path, str => DoLoadErrorCallback(str, system ?? "???", LoadErrorType.DiscError));
+			if (disc == null) return null;
+			try
+			{
+				DiscAsset asset = own ? new OwnedDiscAsset() : new DiscAsset();
+				asset.DiscData = disc; asset.DiscType = new DiscIdentifier(disc).DetectDiscType();
+				asset.DiscName = Path.GetFileNameWithoutExtension(path); return asset;
+			}
+			catch { if (own) disc.Dispose(); throw; }
+		}
+		private List<IDiscAsset> LoadXmlDiscAssets(XmlGame xml, string forcedCoreName)
+		{
+			var result = new List<IDiscAsset>();
+			try
+			{
+				foreach (var item in xml.Assets.Where(p => IsDiscForXML(xml.GI.System, p.Path)))
+					if (MountDiscAsset(item.Path, xml.GI.System, forcedCoreName) is { } disc) result.Add(disc);
+				return result;
+			}
+			catch { foreach (var asset in result.OfType<IOwnedDiscAsset>()) asset.Dispose(); throw; }
+		}
