+  private static void PreferredMediaDoesNotFallback()
+  {
+   var hdf = new byte[1024 * 1024]; hdf[0] = (byte)'D'; hdf[1] = (byte)'O'; hdf[2] = (byte)'S';
+   var hdfPath = Path.Combine(Stage, "Own.hdf"); File.WriteAllBytes(hdfPath, hdf);
+   foreach (var media in new[] { Path.Combine(Stage, "Own.adf"), hdfPath })
+   {
+    foreach (bool incompatible in new[] { false, true })
+    {
+     var config = Configuration("PUAE6"); config.DontTryOtherCores = false;
+     var provider = new CoreFileProvider(null, new FirmwareManager(), config.PathEntries, config.FirmwareUserSpecifications);
+     var comm = new CoreComm(_ => { }, (_, _) => { }, provider, CoreComm.CorePreferencesFlags.None, null);
+     var requested = new List<string>(); var errors = new List<string>();
+     var loader = new RomLoader(config, null);
+     loader.OnLoadError += (_, e) => errors.Add(e.Message);
+     loader.OnLoadSettings += (_, e) => e.Settings = e.Core == typeof(UAE) ? (object)new UAE.UAESettings() : new Puae6Settings();
+     loader.OnLoadSyncSettings += (_, e) =>
+     {
+      requested.Add(e.Core == typeof(UAE) ? "UAE" : e.Core == typeof(Puae6Core) ? "PUAE6" : e.Core.Name);
+      e.Settings = e.Core == typeof(UAE) ? (object)new UAE.UAESyncSettings()
+       : new Puae6SyncSettings { Machine = incompatible ? Puae6Machine.CD32 : Puae6Machine.A500, WhdLoad = Puae6WhdLoadMode.Disabled };
+     };
+     bool loaded = loader.LoadRom(media, comm, null);
+     Require(requested.SequenceEqual(new[] { "PUAE6" }), "Preferred PUAE6 fell back while opening " + Path.GetExtension(media));
+     if (incompatible)
+      Require(!loaded && errors.Count == 1 && errors[0].Contains("CD32 requires its own model"), "Preferred PUAE6 error was hidden");
+     else
+     {
+      Require(loaded && loader.LoadedEmulator is Puae6Core && errors.Count == 0,
+       "Preferred PUAE6 did not load " + Path.GetExtension(media) + ": " + string.Join(" | ", errors));
+      loader.LoadedEmulator.Dispose();
+     }
+    }
+   }
+   File.Delete(hdfPath);
+  }
