diff --git a/src/BizHawk.Emulation.DiscSystem/DiscFormats/CHD_Puae6.cs b/src/BizHawk.Emulation.DiscSystem/DiscFormats/CHD_Puae6.cs
--- /dev/null
+++ b/src/BizHawk.Emulation.DiscSystem/DiscFormats/CHD_Puae6.cs
@@ -0,0 +1,87 @@
+using System.Collections.Generic;
+using System.IO;
+using System.Runtime.InteropServices;
+using System.Text;
+using Microsoft.Win32.SafeHandles;
+
+namespace BizHawk.Emulation.DiscSystem
+{
+ public static partial class CHD_Format
+ {
+  // Explicit PUAE6 CDv5 backend; the default chd-rs path is unchanged.
+  public static Disc LoadPuae6Chd(string path, DiscMountPolicy policy)
+  {
+   if (policy == null) throw new ArgumentNullException(nameof(policy));
+   var blob = new Puae6ChdBlob(path);
+   try
+   {
+    var metadata = new List<CHDCdMetadata>();
+    for (uint i = 0; i < blob.Geometry.Tracks; ++i) metadata.Add(blob.Metadata(i));
+    return LoadCHDToDisc(metadata, blob.Geometry.UnitBytes, blob, policy);
+   }
+   catch { blob.Dispose(); throw; }
+  }
+  internal sealed unsafe class Puae6ChdBlob : SafeHandleZeroOrMinusOneIsInvalid, IBlob
+  {
+   [StructLayout(LayoutKind.Sequential)]
+   internal struct Info { public uint Version, Size, UnitBytes, HunkBytes, Tracks, Reserved; public ulong Bytes; }
+   [StructLayout(LayoutKind.Sequential)]
+   struct TrackDto
+   {
+    public uint Version, Size, Number, Frames, Pregap, Postgap, ExtraFrames, StoredPregap, Flags, Reserved;
+    public ulong OffsetFrames;
+    public fixed byte Type[16], Subtype[8], Pgtype[16], Pgsub[8];
+   }
+   const string Library = "p6_chd_host";
+   [DllImport(Library, EntryPoint = "p6_chd_host_open", CallingConvention = CallingConvention.Cdecl)]
+   static extern int Open(byte[] path, out IntPtr owner, ref Info info);
+   [DllImport(Library, EntryPoint = "p6_chd_host_get_track", CallingConvention = CallingConvention.Cdecl)]
+   static extern int GetTrack(Puae6ChdBlob owner, uint index, ref TrackDto track);
+   [DllImport(Library, EntryPoint = "p6_chd_host_read", CallingConvention = CallingConvention.Cdecl)]
+   static extern int ReadNative(Puae6ChdBlob owner, ulong offset, byte* output, uint count);
+   [DllImport(Library, EntryPoint = "p6_chd_host_close", CallingConvention = CallingConvention.Cdecl)]
+   static extern void Close(IntPtr owner);
+   internal readonly Info Geometry;
+   readonly byte[] staging = new byte[2448];
+   static void CheckLayout()
+   {
+    if (sizeof(Info) != 32 || Marshal.OffsetOf<Info>(nameof(Info.Bytes)).ToInt32() != 24
+     || sizeof(TrackDto) != 96 || Marshal.OffsetOf<TrackDto>(nameof(TrackDto.OffsetFrames)).ToInt32() != 40
+     || Marshal.OffsetOf<TrackDto>(nameof(TrackDto.Type)).ToInt32() != 48) throw new TypeLoadException("PUAE6 CHD ABI layout");
+   }
+   internal Puae6ChdBlob(string path) : base(true)
+   {
+    CheckLayout();
+    if (path == null) throw new ArgumentNullException(nameof(path));
+    if (path.IndexOf('\0') >= 0) throw new ArgumentException("CHD path contains NUL", nameof(path));
+    var info = new Info { Version = 1, Size = (uint)sizeof(Info) };
+    Check(Open(Encoding.UTF8.GetBytes(path + '\0'), out var owner, ref info), "open");
+    SetHandle(owner); Geometry = info;
+   }
+   static void Check(int status, string phase)
+   {
+    if (status != 0) throw new IOException($"PUAE6 CHD host {phase} failed: {status}");
+   }
+   static string Text(byte* p) => Marshal.PtrToStringAnsi((IntPtr)p);
+   internal CHDCdMetadata Metadata(uint index)
+   {
+    var t = new TrackDto { Version = 1, Size = (uint)sizeof(TrackDto) };
+    Check(GetTrack(this, index, ref t), "track");
+    var type = GetTrackType(Text(t.Type)); var sub = GetSubType(Text(t.Subtype));
+    var (pgtype, stored) = GetTrackTypeForPregap(Text(t.Pgtype));
+    return new CHDCdMetadata { Track = t.Number, TrackType = type, SubType = sub, Frames = t.Frames,
+     Pregap = t.Pregap, PostGap = t.Postgap, ExtraFrames = t.ExtraFrames, PregapInChd = stored,
+     PregapTrackType = pgtype, PregapSubType = GetSubType(Text(t.Pgsub)), ByteSwapAudio = true,
+     SectorSize = GetSectorSize(type), SubSize = GetSubSize(sub) };
+   }
+   public int Read(long bytePos, byte[] buffer, int offset, int count)
+   {
+    if (IsClosed || bytePos < 0 || count < 0 || count > 2448 || buffer == null || offset < 0
+     || offset > buffer.Length - count) throw new IOException("PUAE6 CHD read range/disposed");
+    fixed (byte* output = staging) Check(ReadNative(this, (ulong)bytePos, output, (uint)count), "read");
+    Buffer.BlockCopy(staging, 0, buffer, offset, count); return count;
+   }
+   protected override bool ReleaseHandle() { Close(handle); return true; }
+  }
+ }
+}
