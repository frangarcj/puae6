+		private static void ValidatePuae6Dao(NRGFile file)
+		{
+			void Check(bool ok) { if (!ok) throw new NRGParseException("Invalid bounded DAO session geometry"); }
+			var count = file.DAOTrackInfos.Count;
+			Check(count is >= 1 and <= 99 && file.Cues.Count == count &&
+				(file.SessionInfos.Count == count || count == 1 && file.SessionInfos.Count == 0));
+			int first = 1, previousA2 = 0;
+			long previousEnd = 0;
+			for (var group = 0; group < count; group++)
+			{
+				var dao = file.DAOTrackInfos[group]; var cues = file.Cues[group].TrackIndices;
+				Check(dao.FirstTrack == first && dao.LastTrack >= first && dao.LastTrack <= 99 &&
+					dao.Tracks.Count == dao.LastTrack - first + 1 && dao.DiskType is 0 or 0x10 or 0x20);
+				Check(file.SessionInfos.Count == 0 || file.SessionInfos[group].TrackCount == dao.Tracks.Count);
+				var seen = new HashSet<int>();
+				foreach (var cue in cues)
+				{
+					int track = cue.Track.BCDValue, index = cue.Index.BCDValue;
+					Check((cue.ADRControl & 15) == 1 && seen.Add(track * 256 + index));
+					if (track == 0 || track == 0xaa) Check(index == (track == 0 ? 0 : 1));
+					else Check((track & 15) <= 9 && (track >> 4) <= 9 &&
+						cue.Track.DecimalValue >= first && cue.Track.DecimalValue <= dao.LastTrack && index <= 1);
+				}
+				var leadin = cues.FirstOrDefault(c => c.Track.BCDValue == 0);
+				var leadout = cues.FirstOrDefault(c => c.Track.BCDValue == 0xaa);
+				Check(leadin != null && leadout != null);
+				Check(leadout.LBA > 0 && (group == 0 ? leadin.LBA <= 0 : leadin.LBA >= previousA2));
+				long Zero(int number)
+				{
+					var t = dao.Tracks[number - first];
+					var one = cues.FirstOrDefault(c => c.Track.DecimalValue == number && c.Index.BCDValue == 1);
+					Check(one != null);
+					return (long)one.LBA - (t.TrackStartFileOffset - t.PregapFileOffset) / t.SectorSize;
+				}
+				// Validate physical extents before division, including the next track used by Zero.
+				foreach (var t in dao.Tracks)
+				{
+					var minimum = t.Mode switch { 0 or 2 => 2048, 3 => 2336, 5 or 6 or 7 => 2352, 15 or 16 or 17 => 2448, _ => 0 };
+					Check(minimum != 0 && t.SectorSize >= minimum && (t.Mode == 2 ? t.SectorSize == 2048 :
+						t.Mode == 3 ? t.SectorSize == 2336 : t.SectorSize is 2048 or 2352 or 2448));
+					Check(t.PregapFileOffset >= previousEnd && t.TrackStartFileOffset >= t.PregapFileOffset &&
+						t.TrackEndFileOffset > t.TrackStartFileOffset && t.TrackEndFileOffset <= file.FileOffset &&
+						(t.TrackStartFileOffset - t.PregapFileOffset) % t.SectorSize == 0 &&
+						(t.TrackEndFileOffset - t.TrackStartFileOffset) % t.SectorSize == 0);
+					previousEnd = t.TrackEndFileOffset;
+				}
+				for (var number = first; number <= dao.LastTrack; number++)
+				{
+					var t = dao.Tracks[number - first];
+					var one = cues.FirstOrDefault(c => c.Track.DecimalValue == number && c.Index.BCDValue == 1);
+					var zero = cues.FirstOrDefault(c => c.Track.DecimalValue == number && c.Index.BCDValue == 0);
+					var start = Zero(number); var end = number == dao.LastTrack ? leadout.LBA : Zero(number + 1);
+					Check(one.LBA >= 0 && end > one.LBA && (zero == null || zero.LBA == start && zero.ADRControl == one.ADRControl) &&
+						end - one.LBA == (t.TrackEndFileOffset - t.TrackStartFileOffset) / t.SectorSize &&
+						(number != first || leadin.LBA <= start) &&
+						(((one.ADRControl >> 4) & 4) == 0) == (t.Mode is 7 or 16));
+				}
+				first = dao.LastTrack + 1; previousA2 = leadout.LBA;
+			}
+		}
