+				var blob=new Blob_RawFile { PhysicalPath=path }; disc.DisposableResources.Add(blob);
+				disc.SynthProvider=new Puae6DaoProvider(disc,blob,policy);
+				foreach(var s in disc.Puae6NrgDao.Sessions)
+				{
+					if(s.A2>int.MaxValue-150) throw new NotSupportedException("NRG TOC address overflows timestamp");
+					var session=new DiscSession { Number=disc.Sessions.Count };
+					new Synthesize_A0A1A2_Job(s.FirstTrack,s.LastTrack,(SessionFormat)s.Format,s.A2+150).Run(session.RawTOCEntries);
+					foreach(var t in disc.Puae6NrgDao.Tracks.Where(t=>t.Number>=s.FirstTrack&&t.Number<=s.LastTrack))
+					{
+						var q=default(SubchannelQ); q.SetStatus((byte)t.Adr,(EControlQ)t.Control); q.q_index=BCD2.FromDecimal(t.Number); q.AP_Timestamp=t.Index1+150;
+						session.RawTOCEntries.Add(new() { QData=q, AbsoluteTimestamp=t.Index1+150 });
+					}
+					disc.Sessions.Add(session);
+				}
+				return disc;
+			}
+			catch { disc.Dispose(); throw; }
