{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {
      "name": "native-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "P6_PROFILE": "deterministic-a500",
        "P6_SANITIZERS": "ON"
      }
    },
    {
      "name": "native-release",
      "inherits": "native-debug",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "P6_SANITIZERS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "native-debug", "configurePreset": "native-debug"},
    {"name": "native-release", "configurePreset": "native-release"}
  ],
  "testPresets": [
    {"name": "native-debug", "configurePreset": "native-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "native-release", "configurePreset": "native-release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
