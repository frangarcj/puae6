+#ifdef P6_PORTABLE
+// A second pointer uses the existing Amiga-port counters, not a remapping of
+// host widgets (which would clear held keys). Only the bridge boundary calls it.
+void p6_input_mouse2(bool enabled, unsigned buttons, int dx, int dy)
+{
+	mouse_port[1] = enabled ? 1 : 0;
+	joybutton[1] = buttons;
+	joydir[1] = 0;
+	if (enabled) {
+		mouse_delta[1][0] += dx;
+		mouse_delta[1][1] += dy;
+		mouse_deltanoreset[1][0] = mouse_deltanoreset[1][1] = 0;
+	} else {
+		memset(mouse_delta[1], 0, sizeof mouse_delta[1]);
+		memset(mouse_deltanoreset[1], 0, sizeof mouse_deltanoreset[1]);
+	}
+}
+#endif
