+#ifdef P6_IPF
+/* One revolution of a track of the IPF in the drive into the track buffer (T58): its cells as the words of the MFM stream, the time of each group of eight, the length and, the
+ * first time, whether the track has cells that read differently at each revolution (multi_revolution: DISK_update asks for the next one at every index) and where the write splice
+ * is (skipoffset). False, and the buffer as it was, when the image has no such track or the decoder cannot read it. The weak cells are a function of the track and the revolution. */
+static bool ipf_decode_track(drive *drv, int track, int revolution, bool first)
+{
+	p6_ipf::Track info;
+	if (!drv->ipf || p6_ipf::decode(drv->ipf, track, revolution, drv->bigmfmbuf, MAXMFMBUF, drv->tracktiming, MAXMFMBUF, &info) != p6_ipf::kDecoded)
+		return false;
+	drv->tracklen = info.cells;
+	if (first) {
+		drv->multi_revolution = info.weak ? 1 : 0;
+		drv->skipoffset = info.splice;
+	}
+	return true;
 }
+#endif
 
