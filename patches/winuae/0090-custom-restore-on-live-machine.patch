@@ -8088,9 +8095,11 @@
 	RW;						/* 1F6 ? */
 	RW;						/* 1F8 ? */
 	i = RW;					/* 1FA ? */
+#ifndef P6_PORTABLE
 	if (i & 0x8000) {
 		currprefs.ntscmode = changed_prefs.ntscmode = i & 1;
 	}
+#endif
 	fmode = RW;				/* 1FC FMODE */
 	last_custom_value = RW; /* 1FE ? */
