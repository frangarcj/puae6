+#ifdef P6_PORTABLE
+/* Native state (bridge/state_hdf.cpp, patch 0321): values only. The registers Gayle keeps for its IDE port, in this order: 0 gayle_irq, 1 gayle_int, 2 gayle_id_cnt,
+ * 3 ide_splitter. The PCMCIA registers (cs, cs mask, cfg) and the Dataflyer are never written without a card slot or the board; false when one is not zero. */
+#define P6_GAYLE_WORDS 4
+bool p6_gayle_words_valid(const uint32_t *w, unsigned n, bool splitter);
+
+bool p6_gayle_state_get(uint32_t *w, unsigned n)
+{
+	if (!w || n != P6_GAYLE_WORDS || gayle_cs || gayle_cs_mask || gayle_cfg || external_card_int || dataflyer_state || dataflyer_disable_irq || dataflyer_byte)
+		return false;
+	w[0] = gayle_irq;
+	w[1] = gayle_int;
+	w[2] = uint32_t(gayle_id_cnt);
+	w[3] = uint32_t(ide_splitter);
+	return p6_gayle_words_valid (w, n, ide_splitter != 0);
+}
+
+/* Pure: whether the words can be the registers of Gayle on a machine whose drives are (splitter) or are not on the second channel. The bridge asks while it validates a state, before the
+ * machine has run its reset head, so that applying one cannot fail. The ID counter counts the reads of the ID register since the last write, without a bound. */
+bool p6_gayle_words_valid(const uint32_t *w, unsigned n, bool splitter)
+{
+	return w && n == P6_GAYLE_WORDS && w[0] <= 0xff && w[1] <= 0xff && w[2] <= 0x7fffffff && w[3] == (splitter ? 1u : 0u);
+}
+
+/* The inverse of p6_gayle_state_get, for a machine of the same configuration that has run its reset head (the drives are open). */
+bool p6_gayle_state_set(const uint32_t *w, unsigned n)
+{
+	if (!p6_gayle_words_valid (w, n, ide_isdrive (idedrive[2]) || ide_isdrive (idedrive[3])))
+		return false;      // the splitter follows from the drives that are there
+	gayle_irq = uae_u8(w[0]);
+	gayle_int = uae_u8(w[1]);
+	gayle_id_cnt = int(w[2]);
+	ide_splitter = int(w[3]);
+	return true;
+}
+
+/* One of the four IDE slots (0 and 1 the channel of Gayle, 2 and 3 the second one): see p6_ide_state_get in ide.cpp. A slot without a drive has registers all the same, as the two
+ * drives of a channel share them. */
+bool p6_gayle_drive_state_get(unsigned unit, uint32_t *w, unsigned n, uint8_t *secbuf, uint32_t *secbuf_size)
+{
+	return unit < 2 * 2 && idedrive[unit] && p6_ide_state_get (idedrive[unit], w, n, secbuf, secbuf_size);
+}
+
+bool p6_gayle_drive_state_set(unsigned unit, const uint32_t *w, unsigned n, const uint8_t *secbuf, uint32_t secbuf_size)
+{
+	return unit < 2 * 2 && idedrive[unit] && p6_ide_state_set (idedrive[unit], w, n, secbuf, secbuf_size);
+}
+#endif
