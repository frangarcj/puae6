+static volatile int mediachanged;
+struct AkikoClock {
+	evt_t cycle;
+	uae_u64 rate, sector, qcode, media;
+	bool first, q_due, media_due;
+	int speed;
+};
+static AkikoClock akiko_clock;
+static void akiko_clock_reset(void)
+{
+	akiko_clock = {get_cycles(), static_cast<uae_u64>(currprefs.ntscmode ? CHIPSET_CLOCK_NTSC : CHIPSET_CLOCK_PAL) * CYCLE_UNIT,
+		0, 0, 0, true, false, false, 1};
+	subcodecounter = 0;
+}
+static bool akiko_clock_step(uae_u64 &phase, uae_u64 increment, uae_u64 period)
+{
+	phase += increment;
+	const bool due = phase >= period;
+	phase %= period;
+	return due;
+}
+static bool akiko_clock_tick(bool *sector_due, bool *sub_due)
+{
+	const evt_t now = get_cycles();
+	if (now == akiko_clock.cycle)
+		return false; // A callback alone cannot move emulated hardware.
+	if (now < akiko_clock.cycle || !akiko_clock.rate || cdrom_speed < 1 || cdrom_speed > 2 ||
+		static_cast<uae_u64>(now - akiko_clock.cycle) > akiko_clock.rate / 150) {
+		write_log(_T("Akiko clock: invalid hsync interval or uninitialized/reset clock\n"));
+		abort();
+	}
+	const uae_u64 delta = now - akiko_clock.cycle;
+	akiko_clock.cycle = now;
+	const uae_u64 increment = delta * (75 * cdrom_speed);
+	*sector_due = akiko_clock_step(akiko_clock.sector, increment, akiko_clock.rate) || akiko_clock.first;
+	akiko_clock.q_due = akiko_clock_step(akiko_clock.qcode, delta * 2, akiko_clock.rate) || akiko_clock.first;
+	akiko_clock.media_due = akiko_clock_step(akiko_clock.media, delta, akiko_clock.rate * 2) || akiko_clock.first;
+	const bool changed = akiko_clock.speed != cdrom_speed;
+	akiko_clock.speed = cdrom_speed;
+	*sub_due = akiko_clock.first || (!changed && subcodecounter > 0 && --subcodecounter == 0);
+	if (*sector_due || changed) {
+		// Predict the next sector boundary from its exact remainder. Lead it
+		// by five lines; never shorten the sector oscillator itself.
+		const uae_u64 left = akiko_clock.rate - akiko_clock.sector;
+		const int lines = int((left + increment - 1) / increment);
+		if (changed && !*sector_due && lines <= 5)
+			*sub_due = true;
+		subcodecounter = lines > 5 ? lines - 5 : 0;
+	}
+	akiko_clock.first = false;
+	return true;
+}
 
