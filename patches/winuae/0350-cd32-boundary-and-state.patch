+#ifdef P6_PORTABLE
+// A CD32 pad does not need host-device enumeration or a configuration change.
+// The bridge sends all its levels once at the boundary, as MacHawk's bizhawk.c does.
+extern void p6_cia_get(int num, p6_cia_raw *out);
+void p6_input_cd32(int port, bool enabled, unsigned buttons, unsigned directions)
+{
+	if (cd32_pad_enabled[port] != int(enabled)) {
+		cd32_shifter[port] = 8;
+		p6_cia_raw cia{};
+		p6_cia_get(0, &cia);
+		cd32_oldstate[port] = cia.pra & cia.dra & (0x40 << port);
+	}
+	cd32_pad_enabled[port] = enabled ? 1 : 0;
+	joybutton[port] = buttons;
+	joydir[port] = directions;
+	joymousecounter(port);
+}
+#endif
