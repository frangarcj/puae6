+	if (s && armodel == 1) {
+		// Enter clears SPC while ACTIVE. Byte strobe arms WAIT_PC; word strobe
+		// calls ar3a twice and can leave IDLE with SPC still set. Never infer from PC.
+		const bool pending = (spc & SPCFLAG_ACTION_REPLAY) != 0;
+		const bool waiting = s->flag == ACTION_REPLAY_WAIT_PC;
+		const bool idle = s->flag == ACTION_REPLAY_IDLE;
+		const bool active = s->flag == ACTION_REPLAY_ACTIVE;
+		const bool activate = s->flag == ACTION_REPLAY_ACTIVATE;
