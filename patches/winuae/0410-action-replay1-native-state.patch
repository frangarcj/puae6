+			(!(waiting || idle) || !s->wait_pop) && (!(waiting || activate) || pending) && (!active || !pending);
+	}
 	if (!s || (s->flag != ACTION_REPLAY_WAITRESET && (s->flag < ACTION_REPLAY_IDLE || s->flag > ACTION_REPLAY_HIDE)) ||
