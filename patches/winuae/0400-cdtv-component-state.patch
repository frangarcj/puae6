+}
+template<CdtvOp op, class S> static void cdtv_buffers(S &s)
+{
+    if constexpr (op == CdtvOp::Capture) memcpy(s.input, cdrom_command_input, sizeof s.input); else memcpy(cdrom_command_input, s.input, sizeof s.input);
+    if constexpr (op == CdtvOp::Capture) memcpy(s.output, cdrom_command_output, sizeof s.output); else memcpy(cdrom_command_output, s.output, sizeof s.output);
+    if constexpr (op == CdtvOp::Capture) memcpy(s.q, cdrom_qcode, sizeof s.q); else memcpy(cdrom_qcode, s.q, sizeof s.q);
+    if constexpr (op == CdtvOp::Capture) memcpy(s.nvram, cdtv_battram, sizeof s.nvram); else memcpy(cdtv_battram, s.nvram, sizeof s.nvram);
+    if constexpr (op == CdtvOp::Capture) memcpy(s.sub_used, subcodebufferinuse, sizeof s.sub_used); else memcpy(subcodebufferinuse, s.sub_used, sizeof s.sub_used);
+    if constexpr (op == CdtvOp::Capture) memcpy(s.sub, subcodebuffer, sizeof s.sub); else memcpy(subcodebuffer, s.sub, sizeof s.sub);
+    if constexpr (op == CdtvOp::Capture) memcpy(s.transfer, subtransferbuf, sizeof s.transfer); else memcpy(subtransferbuf, s.transfer, sizeof s.transfer);
+}
+static bool cdtv_ready() { return service_running && currprefs.cs_cdtvcd && !currprefs.cs_cdtvcr && unitnum == 0; }
+uint64_t p6_cdtv_callback_observations() { return callback_observations; }
+void (*p6_cdtv_subcode_handler())(uint32_t) { return subcode_interrupt; }
+bool p6_cdtv_state_get(p6_cdtv_state *s)
+{
+    if (!s || !cdtv_ready() || &get_mem_bank(0xe90000) != &dmac_bank) return false;
+    memset(s, 0, sizeof *s);
+    if (!p6_cd::device_capture(&s->device)) return false;
+    if (!cdtv_fields<CdtvOp::Capture>(*s)) return false;
+    cdtv_buffers<CdtvOp::Capture>(*s);
+    s->callback_mode = s->device.audio.callbacks ? callback_mode : 0;
+    for (unsigned n = 0; n < 100; ++n) s->queue[n] = n < request_size ? requests[(request_head + n) % 100] : 0;
+    for (unsigned n = 0; n < 36; ++n) if (!s->sub_used[n]) memset(s->sub[n], 0, 96);
+    return true;
+}
+bool p6_cdtv_state_validate(const p6_cdtv_state *s, const p6_cdtv_context &c)
+{
+    if (!s || c.cycle < 0 || c.ntsc > 1 || c.cda_period != (c.ntsc ? 41558u : 41179u) || !cdtv_fields<CdtvOp::Validate>(*s) ||
+        !s->device.bound || !s->device.opens || !p6_cd::device_validate(s->device, c.disc, c.cda_period)) return false;
+    if (s->callback_mode > 2 || s->device.audio.callbacks != (s->callback_mode ? 3u : 0u) || (s->dmac_acr & 1) ||
+        (s->cdrom_offset & 1) || (s->cdrom_length & 1) || s->cdrom_offset > INT32_MAX - s->cdrom_length ||
+        (s->seek_deadline && (s->seek_deadline < uint64_t(c.cycle) || s->seek_deadline - c.cycle > uint64_t(c.ntsc ? CHIPSET_CLOCK_NTSC : CHIPSET_CLOCK_PAL) * CYCLE_UNIT / 2))) return false;
+    if (s->cdtv_sectorsize != 512 && s->cdtv_sectorsize != 1024 && s->cdtv_sectorsize != 2048 && s->cdtv_sectorsize != 2052 && s->cdtv_sectorsize != 2336 && s->cdtv_sectorsize != 2340) return false;
+    for (unsigned n = 0; n < 100; ++n) {
+        if (n >= s->request_size) { if (s->queue[n]) return false; }
+        else if (s->queue[n] == 0x110 || s->queue[n] == 0x111) n += std::min(3u, s->request_size - n - 1);
+        else if (s->queue[n] > 0x107) return false;
+    }
+    for (unsigned n = 0; n < 36; ++n) {
+        if (s->sub_used[n] > 1) return false;
+        if (!s->sub_used[n]) for (auto v : s->sub[n]) if (v) return false;
+    }
+    return true;
+}
+bool p6_cdtv_state_apply(const p6_cdtv_state *s, const p6_cdtv_context &c)
+{
+    if (!cdtv_ready() || get_cycles() != c.cycle || !p6_cdtv_state_validate(s, c) ||
+        (&get_mem_bank(0xe90000) != &dmac_bank && &get_mem_bank(0xe90000) != &dummy_bank)) return false;
+    auto status = s->callback_mode == 2 ? statusfunc_imm : s->callback_mode == 1 ? statusfunc : nullptr;
+    auto sub = s->callback_mode ? subfunc : nullptr;
+    if (!p6_cd::device_can_restore(s->device, c.disc, status, sub) || !p6_cd::device_restore(s->device, c.disc, status, sub)) return false;
+    cdtv_fields<CdtvOp::Apply>(*s); cdtv_buffers<CdtvOp::Apply>(*s);
+    request_head = 0; memcpy(requests, s->queue, sizeof requests);
+    if (&get_mem_bank(0xe90000) != &dmac_bank) map_banks(&dmac_bank, 0xe9, 1, 0);
+    return true;
 }
 
