+// One explicit field inventory; Validate never reads live values or writes either owner.
+enum class CdtvOp { Capture, Validate, Apply };
+template<CdtvOp op, class V, class L> static bool cdtv_field(V &v, L &live, int64_t lo, int64_t hi)
+{
+    if constexpr (op == CdtvOp::Capture) v = live;
+    if (v < lo || v > hi) return false;
+    if constexpr (op == CdtvOp::Apply) live = v;
+    return true;
+}
+template<CdtvOp op, class S> static bool cdtv_fields(S &s)
+{
