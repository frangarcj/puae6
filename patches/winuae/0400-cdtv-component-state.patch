+    ok &= cdtv_field<op>(s.dmac_dawr, dmac_dawr, 0, 65535);
+    ok &= cdtv_field<op>(s.dmac_acr, dmac_acr, 0, UINT32_MAX);
+    ok &= cdtv_field<op>(s.dmac_wtc, dmac_wtc, INT32_MIN, INT32_MAX);
+    ok &= cdtv_field<op>(s.dmac_dma, dmac_dma, 0, 1);
+    ok &= cdtv_field<op>(s.activate_stch, activate_stch, 0, 1);
+    ok &= cdtv_field<op>(s.cdrom_command_done, cdrom_command_done, 0, 1);
+    ok &= cdtv_field<op>(s.cd_playing, cd_playing, 0, 1);
+    ok &= cdtv_field<op>(s.cd_paused, cd_paused, 0, 1);
+    ok &= cdtv_field<op>(s.cd_motor, cd_motor, 0, 1);
+    ok &= cdtv_field<op>(s.cd_media, cd_media, 0, 1);
+    ok &= cdtv_field<op>(s.cd_error, cd_error, 0, 1);
+    ok &= cdtv_field<op>(s.cd_finished, cd_finished, 0, 1);
+    ok &= cdtv_field<op>(s.cd_isready, cd_isready, 0, 1);
+    ok &= cdtv_field<op>(s.cd_audio_finished, cd_audio_finished, 0, 1);
+    ok &= cdtv_field<op>(s.cdrom_sector, cdrom_sector, 0, INT32_MAX);
+    ok &= cdtv_field<op>(s.cdrom_sectors, cdrom_sectors, 0, INT32_MAX);
+    ok &= cdtv_field<op>(s.cdrom_length, cdrom_length, 0, INT32_MAX);
+    ok &= cdtv_field<op>(s.cdrom_offset, cdrom_offset, 0, INT32_MAX);
+    ok &= cdtv_field<op>(s.last_cd_position, last_cd_position, 0, INT32_MAX);
+    ok &= cdtv_field<op>(s.play_start, play_start, 0, INT32_MAX);
+    ok &= cdtv_field<op>(s.play_end, play_end, 0, INT32_MAX);
+    ok &= cdtv_field<op>(s.last_play_pos, last_play_pos, 0, INT32_MAX);
+    ok &= cdtv_field<op>(s.last_play_end, last_play_end, 0, INT32_MAX);
+    ok &= cdtv_field<op>(s.datatrack, datatrack, 0, 1);
+    ok &= cdtv_field<op>(s.cd_audio_status, cd_audio_status, 0, 255);
