+    ok &= cdtv_field<op>(s.cdtvscsi, cdtvscsi, 0, 0);
+    ok &= cdtv_field<op>(s.unitnum, unitnum, 0, 0);
+    ok &= cdtv_field<op>(s.dma_mask, dma_mask, 16777215, 16777215);
+    ok &= cdtv_field<op>(s.service_running, service_running, 1, 1);
+    ok &= cdtv_field<op>(s.callback_mode, callback_mode, 0, 2);
+    ok &= cdtv_field<op>(s.request_size, request_size, 0, 100);
