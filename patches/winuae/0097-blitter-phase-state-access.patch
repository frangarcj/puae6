diff --git a/blitter.cpp b/blitter.cpp
--- a/blitter.cpp
+++ b/blitter.cpp
@@ -2748,4 +2748,41 @@
 	return dstbak;
 }
 
+// Native state (bridge/state_upstream.cpp, sub-body BLTP of P6CH): the phase of the blitter that BLTX and BLIT do not carry. restore_blitter_new puts back the registers, the
+// shifters, the counters and the pipeline of the cycle-exact blitter but not these: blit_queued (restored as a constant when a blit runs, left as the live machine had it when
+// none does), blit_count_done, blt_change_cycles (restore_blitter_new derives it with blit_bltset, from the cycle of the load), the data path latches of a blit in flight
+// (the held A, B and C words the next minterm reads, the line's D latch and pointer, the line pixel of the cycle before) and the pointers a copper write of the same cycle
+// restores. blit_dmacount and blit_cyclecount are in BLTX but its reader drops them and blit_bltset derives them from the registers, which a BLTCON write made while the
+// blitter was idle does not touch: BLTP puts back the ones the saved machine had. Values only, in 32-bit words in the order of the list below; it never runs the blitter and
+// never schedules anything, and a word count other than P6_BLITTER_PHASE_WORDS is refused. The bridge applies it after restore_blitter_finish, which sets
+// blitter_delayed_update: the word that says whether a BLTCON or modulo write is still pending is the saved machine's, not the finish's.
+//  0 blit_queued  1 blit_count_done  2-3 blt_change_cycles (low, high)  4 blitter_delayed_update  5 blit_dmacount  6 blit_cyclecount
+//  7 bltahold2  8 bltbhold2  9 bltchold2  10 bltbhold  11 bltddatl  12 bltdptl  13 blitlinepixel2  14-17 bltapt_prev, bltbpt_prev, bltcpt_prev, bltdpt_prev
+#define P6_BLITTER_PHASE_WORDS 18
+bool p6_blitter_phase_get(int32_t *out, unsigned n)
+{
+	if (!out || n != P6_BLITTER_PHASE_WORDS) return false;
+	const int32_t words[] = {
+		blt_info.blit_queued, blt_info.blit_count_done, int32_t(uint64_t(blt_info.blt_change_cycles)), int32_t(uint64_t(blt_info.blt_change_cycles) >> 32),
+		blitter_delayed_update ? 1 : 0, blit_dmacount, blit_cyclecount,
+		blt_info.bltahold2, blt_info.bltbhold2, blt_info.bltchold2, blt_info.bltbhold, blt_info.bltddatl, int32_t(blt_info.bltdptl), blitlinepixel2,
+		int32_t(blt_info.bltapt_prev), int32_t(blt_info.bltbpt_prev), int32_t(blt_info.bltcpt_prev), int32_t(blt_info.bltdpt_prev)
+	};
+	static_assert(sizeof words / sizeof words[0] == P6_BLITTER_PHASE_WORDS, "review the blitter phase word list");
+	memcpy(out, words, sizeof words);
+	return true;
+}
+
+bool p6_blitter_phase_set(const int32_t *in, unsigned n)
+{
+	if (!in || n != P6_BLITTER_PHASE_WORDS) return false;
+	blt_info.blit_queued = in[0]; blt_info.blit_count_done = in[1];
+	blt_info.blt_change_cycles = evt_t(uint64_t(uint32_t(in[2])) | uint64_t(uint32_t(in[3])) << 32);
+	blitter_delayed_update = in[4] != 0; blit_dmacount = in[5]; blit_cyclecount = in[6];
+	blt_info.bltahold2 = uae_u16(in[7]); blt_info.bltbhold2 = uae_u16(in[8]); blt_info.bltchold2 = uae_u16(in[9]); blt_info.bltbhold = uae_u16(in[10]);
+	blt_info.bltddatl = uae_u16(in[11]); blt_info.bltdptl = uae_u32(in[12]); blitlinepixel2 = in[13];
+	blt_info.bltapt_prev = uae_u32(in[14]); blt_info.bltbpt_prev = uae_u32(in[15]); blt_info.bltcpt_prev = uae_u32(in[16]); blt_info.bltdpt_prev = uae_u32(in[17]);
+	return true;
+}
+
 #endif /* SAVESTATE || P6_STATE_BODIES */
