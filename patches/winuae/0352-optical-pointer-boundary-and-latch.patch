+#ifdef P6_PORTABLE
+// Same raster-to-beam transform as lightpen_update, evaluated at the input
+// boundary. No float, draw pass, crosshair or host desktop geometry is involved.
+void p6_pointer_beam(int x, int y, int *cx, int *cy)
+{
+	const auto *vb = adisplays[0].gfxvidinfo.inbuffer;
+	*cx = *cy = -1;
+	if (!vb || vb->inwidth < 1 || vb->inheight < 1) return;
+	const int px = int((int64_t(x) + 32767) * (vb->inwidth - 1) / 65534);
+	const int py = int((int64_t(y) + 32767) * (vb->inheight - 1) / 65534);
+	const int hx = ((px + visible_left_border) >> (1 + currprefs.gfx_resolution)) + 29;
+	const int vy = (py >> linedbl) + minfirstline;
+	if (hx <= 0x17 || hx >= maxhpos || vy < minfirstline_linear || vy >= current_linear_vpos) return;
+	*cx = hx; *cy = vy;
+}
+#endif
