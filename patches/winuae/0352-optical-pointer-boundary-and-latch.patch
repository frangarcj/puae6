+#ifdef P6_PORTABLE
+extern void p6_pointer_beam(int x, int y, int *cx, int *cy);
+// Exactly one photodiode, with its button on either gameport. No host callbacks.
+void p6_input_pointer(int port, bool enabled, unsigned buttons, int x, int y)
+{
+	joybutton[port] = (buttons & 1) ? (1u << JOYBUTTON_3) : 0;
+	joydir[port] = 0;
+	if (enabled) {
+		lightpen_port[0] = port == 0;
+		lightpen_port[1] = port == 1;
+		lightpen_cx[0] = lightpen_cy[0] = -1;
+		if (!(buttons & 2)) p6_pointer_beam(x, y, &lightpen_cx[0], &lightpen_cy[0]);
+	} else {
+		lightpen_port[port] = 0;
+	}
+	lightpen_enabled = lightpen_port[0] || lightpen_port[1];
+	lightpen_enabled2 = lightpen_active = 0;
+	lightpen_x[0] = lightpen_y[0] = -1;
+	if (!lightpen_enabled) lightpen_cx[0] = lightpen_cy[0] = -1;
+}
+#endif
