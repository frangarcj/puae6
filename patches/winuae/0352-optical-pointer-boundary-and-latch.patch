+#ifdef P6_PORTABLE
+// Optical beam latch: independent of the host device (LPEN also freezes in
+// vertical blank), so P6CH owns it whenever BPLCON0.LPEN is set.
+bool p6_lightpen_latch_get(int32_t out[4])
+{
+	out[0] = vpos_lpen; out[1] = hpos_lpen;
+	out[2] = hhpos_lpen; out[3] = lightpen_triggered;
+	return (bplcon0 & 8) != 0;
+}
+void p6_lightpen_latch_set(const int32_t in[4])
+{
+	vpos_lpen = in[0]; hpos_lpen = in[1];
+	hhpos_lpen = in[2]; lightpen_triggered = in[3];
+}
+#endif
