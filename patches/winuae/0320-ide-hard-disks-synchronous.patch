+#ifdef P6_PORTABLE
+/* Native state of one IDE slot (bridge/state_hdf.cpp, patch 0320): values and the bytes of the sector buffer the drive has in hand; no pointer, no path. The words, in this order:
+ * 0 to 13 the registers (select, nsector, sector, lcyl, hcyl, devcon, error, feat, nsector2, sector2, lcyl2, hcyl2, feat2, status), 14 buffer_offset, 15 data_offset, 16 data_size,
+ * 17 data_multi, 18 direction, 19 intdrq, 20 lba48cmd, 21 and 22 start_lba (low, high), 23 start_nsec, 24 multiple_mode, 25 irq_delay, 26 irq, 27 irq_inhibit, 28 irq_new,
+ * 29 maxtransferstate, 30 ide_drv, 31 mode_8bit, 32 cyls, 33 heads, 34 secspertrack (the INITIALIZE DRIVE PARAMETERS of the guest changes them). What the drive is (its size, its
+ * identity) is the hard file's, named by its content id in the envelope, and is not repeated here.
+ * The buffer: the bytes from its start to the end of what the drive can still hand over or has taken (p6_ide_live_bytes), none for a slot without a drive.
+ * p6_ide_words_valid and p6_ide_live_bytes are pure: the bridge asks them while it validates a state, before the machine has run its reset head, so that applying one cannot fail. */
+#define P6_IDE_WORDS 35
+
+bool p6_ide_words_valid (const uint32_t *w, unsigned n, bool drive)
+{
+	if (!w || n != P6_IDE_WORDS)
+		return false;
+	for (int i = 0; i < 14; i++) {
+		if (w[i] > 0xff)
+			return false;
+	}
+	if (w[14] > P6_IDE_SECBUF_MAX || w[15] > P6_IDE_SECBUF_MAX || w[16] > P6_IDE_SECBUF_MAX || (uint64_t)w[14] + w[15] + w[16] > P6_IDE_SECBUF_MAX || w[17] > 128 || w[18] > 2 ||
+		w[19] > 1 || w[20] > 1 || w[23] > 256 || w[24] > 128 || w[25] > 2 || w[26] > 1 || w[27] > 1 || w[28] > 1 || w[29] > 2 || w[30] > 1 || w[31] > 1 || w[32] > 0x7fffffff || w[33] > 0xffff || w[34] > 0xffff)
+		return false;
+	// a slot without a drive keeps the registers (the two drives of a channel share them) and nothing of a transfer
+	if (!drive && (w[14] || w[15] || w[16] || w[17] || w[18] || w[19] || w[20] || w[21] || w[22] || w[23] || w[24] || w[25] || w[26] || w[27] || w[28] || w[29] || w[31] || w[32] ||
+		w[33] || w[34]))
+		return false;
+	return true;
+}
+
+uint32_t p6_ide_live_bytes (const uint32_t *w, bool drive)
+{
+	if (!drive)
+		return 0;
+	uint64_t live = 512;
+	const uint64_t position = (uint64_t)w[14] + w[15] + w[16];
+	if (position > live)
+		live = position;
+	if (!w[18] && w[16] > 0) {
+		const uint64_t loaded = (uint64_t)w[23] * 512;      // a read keeps handing over what its first request loaded
+		if (loaded > live)
+			live = loaded;
+	}
+	return live > P6_IDE_SECBUF_MAX ? P6_IDE_SECBUF_MAX : (uint32_t)live;
+}
+
+bool p6_ide_state_get (struct ide_hdf *ide, uint32_t *w, unsigned n, uint8_t *secbuf, uint32_t *secbuf_size)
+{
+	if (!ide || !w || n != P6_IDE_WORDS || !secbuf || !secbuf_size || ide->atapi || ide->scsi || ide->packet_state || ide->adide || ide->byteswap || ide->board)
+		return false;
+	const struct ide_registers &r = ide->regs;
+	const uint8_t regs[14] = { r.ide_select, r.ide_nsector, r.ide_sector, r.ide_lcyl, r.ide_hcyl, r.ide_devcon, r.ide_error, r.ide_feat, r.ide_nsector2, r.ide_sector2, r.ide_lcyl2,
+		r.ide_hcyl2, r.ide_feat2, r.ide_status };
+	for (int i = 0; i < 14; i++)
+		w[i] = regs[i];
+	w[14] = (uint32_t)ide->buffer_offset;
+	w[15] = (uint32_t)ide->data_offset;
+	w[16] = (uint32_t)ide->data_size;
+	w[17] = (uint32_t)ide->data_multi;
+	w[18] = (uint32_t)ide->direction;
+	w[19] = ide->intdrq ? 1 : 0;
+	w[20] = ide->lba48cmd ? 1 : 0;
+	w[21] = (uint32_t)ide->start_lba;
+	w[22] = (uint32_t)(ide->start_lba >> 32);
+	w[23] = (uint32_t)ide->start_nsec;
+	w[24] = ide->multiple_mode;
+	w[25] = (uint32_t)ide->irq_delay;
+	w[26] = (uint32_t)ide->irq;
+	w[27] = ide->irq_inhibit ? 1 : 0;
+	w[28] = ide->irq_new ? 1 : 0;
+	w[29] = (uint32_t)ide->maxtransferstate;
+	w[30] = (uint32_t)ide->ide_drv;
+	w[31] = ide->mode_8bit ? 1 : 0;
+	w[32] = (uint32_t)ide->hdhfd.cyls;
+	w[33] = (uint32_t)ide->hdhfd.heads;
+	w[34] = (uint32_t)ide->hdhfd.secspertrack;
+	const bool drive = ide->hdhfd.size != 0;
+	if (!p6_ide_words_valid (w, n, drive))
+		return false;
+	const uint32_t live = p6_ide_live_bytes (w, drive);
+	if (live > (uint32_t)ide->secbuf_size || (live && !ide->secbuf))
+		return false;
+	if (live)
+		memcpy (secbuf, ide->secbuf, live);
+	*secbuf_size = live;
+	return true;
+}
+
+/* The inverse, for a slot of a machine of the same configuration that has run its reset head: false (and nothing touched) when the values cannot belong to such a slot, which a state the
+ * bridge has validated with the two functions above never does. The sector buffer is made large enough for any position the values can name. */
+bool p6_ide_state_set (struct ide_hdf *ide, const uint32_t *w, unsigned n, const uint8_t *secbuf, uint32_t secbuf_size)
+{
+	if (!ide || !w || n != P6_IDE_WORDS || (!secbuf && secbuf_size) || ide->atapi || ide->scsi || ide->packet_state || ide->adide || ide->byteswap || ide->board)
+		return false;
+	const bool drive = ide->hdhfd.size != 0;
+	if (!p6_ide_words_valid (w, n, drive) || secbuf_size != p6_ide_live_bytes (w, drive))
+		return false;
+	if (drive)
+		ide_grow_buffer (ide, P6_IDE_SECBUF_MAX + 2);
+	if (ide->secbuf_size)
+		memset (ide->secbuf, 0, (size_t)ide->secbuf_size);
+	if (secbuf_size)
+		memcpy (ide->secbuf, secbuf, secbuf_size);
+	struct ide_registers &r = ide->regs;
+	r.ide_select = (uae_u8)w[0]; r.ide_nsector = (uae_u8)w[1]; r.ide_sector = (uae_u8)w[2]; r.ide_lcyl = (uae_u8)w[3]; r.ide_hcyl = (uae_u8)w[4]; r.ide_devcon = (uae_u8)w[5];
+	r.ide_error = (uae_u8)w[6]; r.ide_feat = (uae_u8)w[7]; r.ide_nsector2 = (uae_u8)w[8]; r.ide_sector2 = (uae_u8)w[9]; r.ide_lcyl2 = (uae_u8)w[10]; r.ide_hcyl2 = (uae_u8)w[11];
+	r.ide_feat2 = (uae_u8)w[12]; r.ide_status = (uae_u8)w[13];
+	ide->buffer_offset = (int)w[14];
+	ide->data_offset = (int)w[15];
+	ide->data_size = (int)w[16];
+	ide->data_multi = (int)w[17];
+	ide->direction = (int)w[18];
+	ide->intdrq = w[19] != 0;
+	ide->lba48cmd = w[20] != 0;
+	ide->start_lba = ((uae_u64)w[22] << 32) | w[21];
+	ide->start_nsec = (int)w[23];
+	ide->multiple_mode = (uae_u8)w[24];
+	ide->irq_delay = (int)w[25];
+	ide->irq = (int)w[26];
+	ide->irq_inhibit = w[27] != 0;
+	ide->irq_new = w[28] != 0;
+	ide->maxtransferstate = (int)w[29];
+	ide->ide_drv = (int)w[30];
+	ide->mode_8bit = w[31] != 0;
+	ide->hdhfd.cyls = (int)w[32];
+	ide->hdhfd.heads = (int)w[33];
+	ide->hdhfd.secspertrack = (int)w[34];
+	return true;
+}
+#endif /* P6_PORTABLE */
