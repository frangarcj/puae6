+				uae_u32 av, value = border32;
+				memcpy(&av, arow + (uae_u64)x * MPEG_PIXBYTES_32, sizeof av);
+				if (sy >= 0 && sy < mh && sx >= 0 && sx < mw)
+					memcpy(&value, mpeg + ((uae_u64)sy * (uae_u64)mw + (uae_u64)sx) * MPEG_PIXBYTES_32, sizeof value);
+				if (arow[(uae_u64)x * MPEG_PIXBYTES_32] >= GENLOCK_VAL_32)
