+				memcpy(&av, arow + (uae_u64)x * MPEG_PIXBYTES_16, sizeof av);
+				if (sy >= 0 && sy < mh && sx >= 0 && sx < mw)
+					memcpy(&value, mpeg + ((uae_u64)sy * (uae_u64)mw + (uae_u64)sx) * MPEG_PIXBYTES_16, sizeof value);
+				if ((av >> 11) >= GENLOCK_VAL_16)
+					value = av;
+				memcpy(drow + (uae_u64)x * MPEG_PIXBYTES_16, &value, sizeof value);
 			}
 		}
 	}
+	return COMPOSE_OK;
 }
 
