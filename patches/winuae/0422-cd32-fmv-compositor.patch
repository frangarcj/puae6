-				for (int w2 = 0; w2 < mult; w2++) {
-					uae_u32 v;
-					if (s8[0] >= GENLOCK_VAL_32) {
-						v = *((uae_u32*)s8);
-					} else {
-						v = sv;
-					}
-					*d32++ = v;
-					s8 += d;
-				}
+	if (!amiga || !output || !mpeg)
+		return COMPOSE_ARGUMENT;
+	if (w <= 0 || h <= 0 || mw <= 0 || mw > MAX_MPEG_WIDTH || mh <= 0 || mh > MAX_MPEG_HEIGHT)
+		return COMPOSE_GEOMETRY;
+	if ((pixelbytes != MPEG_PIXBYTES_16 && pixelbytes != MPEG_PIXBYTES_32) || mdepth != pixelbytes)
+		return COMPOSE_DEPTH;
+	const uae_u64 row = (uae_u64)w * (uae_u64)pixelbytes;
+	if (amiga_stride < 0 || output_stride < 0 || (uae_u64)amiga_stride < row || (uae_u64)output_stride < row)
+		return COMPOSE_GEOMETRY;
+	const uae_u64 amiga_need = (uae_u64)(h - 1) * (uae_u64)amiga_stride + row;
+	const uae_u64 output_need = (uae_u64)(h - 1) * (uae_u64)output_stride + row;
+	if (amiga_bytes < amiga_need || output_bytes < output_need)
+		return COMPOSE_CAPACITY;
+
+	int mult = 1;
+	while (mult < 4 && (uae_u64)mw * (uae_u64)(mult << 1) <= (uae_u64)w + 8
+		&& (uae_u64)mh * (uae_u64)(mult << 1) <= (uae_u64)h + 8)
+		mult <<= 1;
+	int hoffset = (w / mult - mw) / 2;
+	int voffset = (h / mult - mh) / 2;
+	if (hoffset < 0) hoffset = 0;
+	if (voffset < 0) voffset = 0;
+
+	for (int y = 0; y < h; ++y) {
