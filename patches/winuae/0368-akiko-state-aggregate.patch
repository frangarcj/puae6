+// Canonical Akiko binding: statusfunc_imm differs only in initial negative
+// delay queries. Restore issues no such query; both share future status handling.
+static play_status_callback akiko_state_status(const p6_akiko_state &s)
+{
+    return s.device.audio.callbacks & 1 ? statusfunc : nullptr;
+}
+static play_subchannel_callback akiko_state_sub(const p6_akiko_state &s)
+{
+    return s.device.audio.callbacks & 2 ? subfunc : nullptr;
+}
+bool p6_akiko_state_preflight(const p6_akiko_state *s, const p6_akiko_context &c)
