+}
+bool p6_akiko_state_apply(const p6_akiko_state *s, const p6_akiko_context &c)
+{
+    if (!p6_akiko_state_preflight(s, c)) return false;
+    // No callbacks/reentry: applying the backend leaves controller/transport
+    // readiness unchanged, and all candidate values were validated together.
+    return p6_cd::device_restore(s->device, c.disc, akiko_state_status(*s), akiko_state_sub(*s)) &&
+        p6_akiko_controller_apply(&s->controller, c.cycle) && p6_akiko_transport_apply(&s->transport);
 }
 #endif
 
