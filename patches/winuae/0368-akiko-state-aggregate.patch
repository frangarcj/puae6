+bool p6_akiko_state_validate(const p6_akiko_state *s, const p6_akiko_context &c)
+{
+    return s && p6_akiko_controller_validate(&s->controller, c.config, c.cycle) &&
+        p6_akiko_transport_validate(&s->transport) && p6_cd::device_validate(s->device, c.disc, c.cda_period) &&
