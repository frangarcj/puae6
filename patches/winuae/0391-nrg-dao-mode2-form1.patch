diff --git a/cdrom.cpp b/cdrom.cpp
--- a/cdrom.cpp
+++ b/cdrom.cpp
@@ -235,3 +235,18 @@
 			encode_L2_P (p + 12);
 			encode_L2_Q (p + 12);
 		}
+
+// Form1 EDC/ECC; caller supplies a 2352-byte sector with header/subheader/payload.
+// Preserve those bytes; only the four header bytes are zeroed during P/Q coding.
+// libMirage a9d6a2044b3c7bdf63ca44517ddd5738fd68c69e mirage/sector.c:755..767.
+void encode_l2_mode2_form1(uae_u8 *p)
+{
+    const uae_u32 edc = build_edc(p, 16, 2071);
+    for (unsigned n = 0; n < 4; ++n) p[2072 + n] = (uae_u8)(edc >> (8 * n));
+    uae_u8 header[4];
+    memcpy(header, p + 12, 4);
+    memset(p + 12, 0, 4);
+    encode_L2_P(p + 12);
+    encode_L2_Q(p + 12);
+    memcpy(p + 12, header, 4);
+}
