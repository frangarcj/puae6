@@ -1437,8 +1439,31 @@
 	int off2 = bitoffset % 8;
 	p[off1] |= bit << (7 - off2);
 	bitoffset++;
+}
+
+
+/* The weak bits and the jitter of a low-level track are drawn at random, which upstream does with the emulator's generator: a decode then changes the machine's future, and the
+ * track a state restore decodes again is not the one the original had. Here the draws are a function of the track and of the revolution (the caller counts them), so a decode is
+ * a function of the image alone and uses nothing of the machine. xorshift32 from a mixed seed. */
+static uae_u32 fdi_seed (int track, int serial)
+{
+	uae_u32 x = (uae_u32)track * 0x9E3779B1u + (uae_u32)serial * 0x85EBCA6Bu + 0x2545F491u;
+	x ^= x >> 15; x *= 0x2C1B3C6Du; x ^= x >> 12; x *= 0x297A2D39u; x ^= x >> 15;
+	return x ? x : 1;
+}
+
+static uae_u32 fdi_rand (FDI *fdi)
+{
+	uae_u32 x = fdi->rand_state;
+	x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+	fdi->rand_state = x;
+	return x >> 1;
 }
 
+void fdi2raw_set_revolution (FDI *fdi, int serial)
+{
+	fdi->serial = serial;
+}
 
