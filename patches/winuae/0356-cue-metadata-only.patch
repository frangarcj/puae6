+static int cue_number(const char *s)
+{
+    if (!s || !*s) return -1;
+    int value = 0;
+    for (; *s; ++s) { if (*s < '0' || *s > '9' || value > 99) return -1; value = value * 10 + *s - '0'; }
+    return value;
+}
+static int cue_time(const char *s)
+{
+    if (!s || strlen(s) != 8 || s[2] != ':' || s[5] != ':') return -1;
+    for (unsigned n : {0u, 1u, 3u, 4u, 6u, 7u}) if (s[n] < '0' || s[n] > '9') return -1;
+    const int seconds = (s[3] - '0') * 10 + s[4] - '0', frames = (s[6] - '0') * 10 + s[7] - '0';
+    return seconds < 60 && frames < 75 ? ((s[0] - '0') * 10 + s[1] - '0') * 4500 + seconds * 75 + frames : -1;
+}
