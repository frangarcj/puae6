+static int cue_compare(const char *a, const char *b, size_t count)
+{
+    for (size_t n = 0; n < count; ++n) {
+        const unsigned x = static_cast<unsigned char>(a[n]), y = static_cast<unsigned char>(b[n]);
+        const unsigned ax = x >= 'a' && x <= 'z' ? x - 32 : x, by = y >= 'a' && y <= 'z' ? y - 32 : y;
+        if (ax != by || !x) return int(ax) - int(by);
+    }
+    return 0;
+}
+#define _tcsnicmp cue_compare
+#define _tcsicmp(a,b) cue_compare(a,b,SIZE_MAX)
