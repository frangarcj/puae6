+#ifdef P6_PORTABLE
+// Real parallel-adapter levels, consumed by the CIA handlers inside the engine.
+// No host enumeration, event replay, quadrature counters or callbacks per read.
+bool p6_input_parallel_active() { return parport_joystick_enabled != 0; }
+void p6_input_parallel(bool enabled, const uint32_t buttons[2], const uint32_t directions[2])
+{
+	parport_joystick_enabled = enabled;
+	for (int p = 0; p < 2; p++) { joybutton[p + 2] = buttons[p]; joydir[p + 2] = directions[p]; }
