-// The overlay is derived: the ROM is at address 0 while OVL (PRA bit 0, high when CIA-A's pin is an input) is set. bfe001_change maps it only when the
-// bit changes; after a restore the map is whatever memory_reset left, so it is made again from PRA and DDRA, after every chunk is applied.
+// CIA profiles derive OVL from PRA/DDRA. CD32 has a one-shot latch instead:
+// every first CIA-A write clears oldovl, independently of those pins.
+bool p6_cia_autooverlay_supported(void)
+{
+    return currprefs.cs_compatible == CP_CD32 && currprefs.cs_cd32cd &&
+        currprefs.cs_cd32c2p && currprefs.cs_cd32nvram && currprefs.cs_cd32nvram_size == 1024;
+}
 void p6_cia_overlay_rebuild(void)
 {
-	const uae_u8 v = cia[0].pra | ~cia[0].dra;
-	oldovl = (v & 1) != 0;
-	if (currprefs.cs_ciaoverlay)
-		map_overlay(oldovl ? 0 : 1);
+    if (currprefs.cs_ciaoverlay) {
+        const uae_u8 v = cia[0].pra | ~cia[0].dra;
+        oldovl = (v & 1) != 0;
+    } else if (!p6_cia_autooverlay_supported()) {
+        return; // Unsupported modes are still refused by the boundary check.
+    }
+    map_overlay(oldovl ? 0 : 1);
 }
 
