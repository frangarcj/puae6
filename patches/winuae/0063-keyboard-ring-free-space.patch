diff --git a/keybuf.cpp b/keybuf.cpp
--- a/keybuf.cpp
+++ b/keybuf.cpp
@@ -334,7 +334,19 @@
 	keybuf[kpb_first] = kc;
 	kpb_first = kpb_next;
 	return 1;
+}
+
+#ifdef P6_PORTABLE
+// Free places in the ring (one stays empty). A full ring drops the NEW code, so an edge that does not fit would
+// leave the guest with a key stuck down or up; the bridge sends an edge only when it is certain to fit.
+int keybuf_free (void)
+{
+	int used = kpb_first - kpb_last;
+	if (used < 0)
+		used += KEYBUF_SIZE;
+	return KEYBUF_SIZE - 1 - used;
 }
+#endif
 
 void keybuf_init (void)
 {
