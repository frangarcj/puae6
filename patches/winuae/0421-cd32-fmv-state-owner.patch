+		mpeg_width = mpeg_height = mpeg_depth = cd32_fmv_active = 0;
+		fmv_border_color = fmv_border_color_16 = 0; return true;
+	}
+	if (!mpeg_out_buffer) mpeg_out_buffer = xmalloc(uae_u8, sizeof s->pixels);
+	if (!mpeg_out_buffer) return false;
+	memcpy(mpeg_out_buffer, s->pixels, sizeof s->pixels);
+	mpeg_width = int(s->width); mpeg_height = int(s->height); mpeg_depth = int(s->depth);
+	cd32_fmv_active = int(s->active); fmv_border_color = s->border32; fmv_border_color_16 = uae_u16(s->border16);
+	return true;
+}
