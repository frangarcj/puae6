+bool p6_fmv_genlock_get(p6_fmv_genlock_state *out)
+{
+	if (!out) return false;
+	p6_fmv_genlock_state s{};
+	s.allocated = mpeg_out_buffer != NULL; s.active = cd32_fmv_active;
+	s.width = mpeg_width; s.height = mpeg_height; s.depth = mpeg_depth;
+	s.border32 = fmv_border_color; s.border16 = fmv_border_color_16;
+	if (mpeg_out_buffer) memcpy(s.pixels, mpeg_out_buffer, sizeof s.pixels);
+	if (!p6_fmv_genlock_validate(&s)) return false;
+	*out = s; return true;
+}
+bool p6_fmv_genlock_validate(const p6_fmv_genlock_state *s)
+{
+	if (!s || s->allocated > 1 || s->active > 1 || s->border16 > 0xffff) return false;
+	if (!s->allocated) return !s->active && !s->width && !s->height && !s->depth;
+	return s->width > 0 && s->width <= MAX_MPEG_WIDTH && s->height > 0 && s->height <= MAX_MPEG_HEIGHT &&
+		(s->depth == MPEG_PIXBYTES_16 || s->depth == MPEG_PIXBYTES_32);
+}
+bool p6_fmv_genlock_apply(const p6_fmv_genlock_state *s)
+{
