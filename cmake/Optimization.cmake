# T35b experiments. Defaults preserve the portable -O2 reference; the guest has
# its own toolchain and does not include this native module.
option(P6_NATIVE_IPO "Experimental native interprocedural optimization" OFF)
set(P6_PGO_MODE "OFF" CACHE STRING "Experimental Clang PGO: OFF, GENERATE or USE")
set_property(CACHE P6_PGO_MODE PROPERTY STRINGS OFF GENERATE USE)
set(P6_PGO_DATA "" CACHE FILEPATH "Merged profile from the matching instrumented build")
if(NOT P6_PGO_MODE MATCHES "^(OFF|GENERATE|USE)$")
    message(FATAL_ERROR "P6_PGO_MODE must be OFF, GENERATE or USE")
endif()
if(P6_NATIVE_IPO AND NOT P6_PGO_MODE STREQUAL "OFF")
    message(FATAL_ERROR "Evaluate IPO and PGO separately")
endif()
if(P6_NATIVE_IPO)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT _p6_ipo OUTPUT _p6_ipo_error LANGUAGES C CXX)
    if(NOT _p6_ipo)
        message(FATAL_ERROR "Native IPO unavailable: ${_p6_ipo_error}")
    endif()
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION TRUE)
endif()
if(NOT P6_PGO_MODE STREQUAL "OFF")
    if(NOT CMAKE_C_COMPILER_ID MATCHES "^(Clang|AppleClang)$" OR
       NOT CMAKE_C_COMPILER_ID STREQUAL CMAKE_CXX_COMPILER_ID OR
       NOT CMAKE_C_COMPILER_VERSION VERSION_EQUAL CMAKE_CXX_COMPILER_VERSION)
        message(FATAL_ERROR "PGO requires matching Clang C/C++ compilers and llvm-profdata")
    endif()
    if(P6_PGO_MODE STREQUAL "GENERATE")
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/profiles")
        set(_p6_profile_flag "-fprofile-instr-generate=${CMAKE_CURRENT_BINARY_DIR}/profiles/%m-%p.profraw")
    else()
        if(NOT IS_ABSOLUTE "${P6_PGO_DATA}" OR NOT EXISTS "${P6_PGO_DATA}" OR IS_DIRECTORY "${P6_PGO_DATA}")
            message(FATAL_ERROR "P6_PGO_DATA must name an existing absolute .profdata file")
        endif()
        file(SIZE "${P6_PGO_DATA}" _p6_profile_size)
        if(_p6_profile_size EQUAL 0)
            message(FATAL_ERROR "P6_PGO_DATA is empty")
        endif()
        set(_p6_profile_flag "-fprofile-instr-use=${P6_PGO_DATA}")
        add_compile_options(-Werror=profile-instr-unprofiled -Werror=profile-instr-out-of-date)
    endif()
    add_compile_options("${_p6_profile_flag}")
    add_link_options("${_p6_profile_flag}")
endif()
