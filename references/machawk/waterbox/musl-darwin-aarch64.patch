diff --git a/arch/waterbox_aarch64/pthread_arch.h b/arch/waterbox_aarch64/pthread_arch.h
--- a/arch/waterbox_aarch64/pthread_arch.h
+++ b/arch/waterbox_aarch64/pthread_arch.h
@@ -1,6 +1,6 @@
 static inline struct pthread *__pthread_self()
 {
     long *context;
-    __asm__ ("mrs %0,tpidr_el0" : "=r"(context));
-    return (struct pthread *)context[0];
+    __asm__ ("mov %0,x28" : "=r"(context));
+    return (void *)((char *)context[0] - sizeof(struct pthread));
 }
diff --git a/src/thread/waterbox_aarch64/__set_thread_area.c b/src/thread/waterbox_aarch64/__set_thread_area.c
--- a/src/thread/waterbox_aarch64/__set_thread_area.c
+++ b/src/thread/waterbox_aarch64/__set_thread_area.c
@@ -3,7 +3,7 @@
 int __set_thread_area(void *p)
 {
     long *context;
-    __asm__ ("mrs %0, tpidr_el0" : "=r" (context));
+    __asm__ ("mov %0, x28" : "=r" (context));
     context[0] = (long)p;
     return 0;
 }
