-		if (sector_buffer_info_1[sec] != 0xff && sector_buffer_info_1[sec] != 0) {
+		if (sector_buffer_info_1[sec] != 0xff) {
 			uae_u8 buf[2352];
 
-			memcpy (buf, sector_buffer_1 + sec * 2352, 2352);
+			if (sector_buffer_info_1[sec] != 0) {
+				memcpy (buf, sector_buffer_1 + sec * 2352, 2352);
+			} else {
+				// The prefetch thread (akiko_thread()) tried to read this sector and
+				// came up empty -- typically because a continuous/PBX streaming read
+				// (used by e.g. the CD32 FMV cartridge's driver) ran one sector past
+				// the last sector actually recorded for the current track, into the
+				// run-out area. A real CD drive still completes such a read (often
+				// with garbage or blank data) instead of never responding; deliver a
+				// blank sector so the transfer completes instead of stalling forever
+				// with the interrupt the driver is waiting for never arriving.
+				memset (buf, 0, sizeof buf);
+			}
 			buf[0] = 0;
 			buf[1] = 0;
 			buf[2] = 0;
@@ -1360,7 +1413,7 @@ static void cdrom_run_read (void)
 		} else {
 			inc = 0;
 		}
-		if (sector_buffer_info_1[sec] != 0xff)
+		if (sector_buffer_info_1[sec] != 0xff && sector_buffer_info_1[sec] != 0)
 			sector_buffer_info_1[sec]--;
 #if AKIKO_DEBUG_IO_CMD
 		if (log_cd32 > 0)
