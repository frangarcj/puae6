+		if (fmv_rom_cache_valid) {
+			// See cd32_fmv_preload_rom(): the file is no longer reachable from here
+			// once the guest is running, so use the copy fetched before the seal.
+			memcpy(fmv_rom_bank.baseaddr, fmv_rom_cache, fmv_rom_size);
+		} else {
+			load_rom_rc(aci->rc, ROMTYPE_CD32CART, 262144, 0, fmv_rom_bank.baseaddr, 262144, 0);
