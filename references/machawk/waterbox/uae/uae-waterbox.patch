+		fmv_rom_cache = xmalloc(uae_u8, fmv_rom_size);
+	if (load_rom_rc(rc, ROMTYPE_CD32CART, fmv_rom_size, 0, fmv_rom_cache, fmv_rom_size, 0))
+		fmv_rom_cache_valid = true;
+}
