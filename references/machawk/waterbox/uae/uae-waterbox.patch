@@ -2148,6 +2190,54 @@ static int parse_image (struct cdunit *cdu, const TCHAR *img)
 	cdu->tracks = 0;
 	if (!img)
 		return 0;
+	if (!_tcsnicmp(img, _T("CompactDisk"), 11)) {
+		const TCHAR *p = img + 11;
+		int disk = 0;
+		if (!*p)
+			return 0;
+		while (*p) {
+			if (*p < _T('0') || *p > _T('9'))
+				return 0;
+			disk = disk * 10 + (*p++ - _T('0'));
+		}
+		BizhawkCDTOC toc;
+		if (!bizhawk_cd_get_toc(disk, &toc) || toc.first_track != 1 || toc.last_track < toc.first_track || toc.last_track > BIZHAWK_CD_MAX_TRACKS)
+			return 0;
+		cdu->tracks = toc.last_track - toc.first_track + 1;
+		for (i = 0; i < cdu->tracks; i++) {
+			struct cdtoc *t = &cdu->toc[i];
+			BizhawkCDTrack *source = &toc.tracks[i];
+			if (source->start < 0 || source->end <= source->start || (source->mode != 0 && source->mode != 1 && source->mode != 2)) {
+				cdu->tracks = 0;
+				return 0;
+			}
+			t->address = source->start;
+			t->adr = source->adr;
+			t->ctrl = source->control;
+			t->track = i + 1;
+			// Mode 2 tracks are reported here as plain "mode 2", with no way to
+			// tell a Form 1 (2048 bytes/sector) data track from a Form 2 (2324
+			// bytes/sector) track -- e.g. a CD32 movie track, read by the CD32
+			// FMV cartridge's cdmpeg driver. Treat them as their raw/native 2352
+			// size so a 2048-byte read is never assumed to be Form 1 to extract
+			// (see the ENC_BIZHAWK branch of do_read()): it always falls through
+			// to the raw-sector-plus-local-copy path there instead, which is
+			// correct for either form.
+			t->size = source->mode == 1 ? 2048 : 2352;
+			t->filesize = (uae_s64)(source->end - source->start) * t->size;
+			t->enctype = ENC_BIZHAWK;
+			t->subcode = 2;
+			t->bizhawk_disk = disk;
+			if (i == cdu->tracks - 1)
+				t[1].address = source->end;
+		}
+		if (toc.leadout != toc.tracks[cdu->tracks - 1].end)
+			return 0;
+		write_log(_T("CD: BizHawk disc %d mounted!\n"), disk);
+		cdu->blocksize = 2048;
+		cdu->cdsize = (uae_u64)toc.leadout * cdu->blocksize;
+		return 1;
+	}
 	zcue = zfile_fopen (img, _T("rb"), ZFD_ARCHIVE | ZFD_CD | ZFD_DELAYEDOPEN);
 	if (!zcue)
 		return 0;
