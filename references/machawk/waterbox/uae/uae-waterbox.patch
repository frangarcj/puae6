+// The cartridge ROM cached from the last successful cd32_fmv_preload_rom() call.
+// cd32_fmv_init() only runs once the emulated CPU drives the Zorro II autoconfig
+// handshake, i.e. during frame stepping -- on the Waterbox port that is after the
+// host has sealed the guest's file access, so a fresh open of the ROM file at that
+// point always fails (ENOENT). expamem_init_cd32fmv() runs earlier (still
+// pre-seal) purely to fetch the 128-byte autoconfig header; cd32_fmv_preload_rom()
+// piggybacks on that same opportunity to read the whole ROM while it is still
+// reachable, so cd32_fmv_init() can copy it from here instead of reopening it.
+static uae_u8 *fmv_rom_cache;
+static bool fmv_rom_cache_valid;
