 	}
 	sector = cdrom_current_sector = cdrom_data_offset + cdrom_sector_counter;
 	sec = sector - sector_buffer_sector_1;
+#ifdef WATERBOX
+	// akiko_thread() prefetches sectors in bulk (up to SECTOR_BUFFER_SIZE at a time)
+	// but on this cooperatively-scheduled Waterbox guest it only gets to run about
+	// once per video frame. A continuous/PBX streaming reader that is allowed to run
+	// faster than real 1x/2x CD speed (e.g. the CD32 FMV cartridge's CDXL/cdmpeg
+	// player) can call cdrom_run_read() for a sector the prefetch thread has not
+	// reached yet -- either it fell outside the buffered window entirely, or its
+	// slot in the window is queued but not filled (info byte 0). Previously that
+	// meant either silently skipping the transfer for this call (sector outside the
+	// window: no data, no interrupt, retried next call) or handing back a blank
+	// sector for a queued-but-unfilled slot -- both are audible as dropped/silent
+	// audio when it happens while a track is genuinely mid-stream, rather than at a
+	// real end-of-track run-out. Yield once here so the prefetch thread's next turn
+	// happens immediately instead of on the next frame boundary, then recheck: this
+	// is a single, bounded attempt (no loop), so a genuine run-out still falls
+	// through to the existing blank-sector/no-op handling below exactly as before.
