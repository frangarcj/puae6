<Project Sdk="Microsoft.NET.Sdk">
	<!-- T20: loads the BizHawk.Emulation.Cores that integration/bizhawk/patches/build_tree.py builds (net48, with the PUAE6 core inside) and asks BizHawk's own
	     CoreInventory what it finds, by reflection: nothing of BizHawk is referenced at compile time. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseAppHost>false</UseAppHost>
		<RollForward>Major</RollForward>
	</PropertyGroup>
</Project>
