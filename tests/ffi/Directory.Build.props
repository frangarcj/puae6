<Project>
	<!-- Outputs go to build/, never next to the sources; set here because MSBuild reads it before the SDK props. -->
	<PropertyGroup>
		<BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../build/ffi$(P6ManagedTestSuffix)/obj/</BaseIntermediateOutputPath>
		<BaseOutputPath>$(MSBuildThisFileDirectory)../../build/ffi$(P6ManagedTestSuffix)/bin/</BaseOutputPath>
	</PropertyGroup>
</Project>
