<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>../../build/waterbox-poison/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>../../build/waterbox-poison/bin/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <StartupObject>SnapshotPoison</StartupObject>
  </PropertyGroup>
  <ItemGroup><Compile Include="../../integration/bizhawk/smoke/*.cs" /></ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
